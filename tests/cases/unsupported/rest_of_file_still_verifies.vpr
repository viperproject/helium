// One method uses a construct we do not implement; the other must still be
// verified, and the method that calls the rejected one must not be.
field f: Int

method uses_exists(n: Int)
  requires exists i: Int :: i == n
{
  assert true
}

method fine(x: Ref)
  requires acc(x.f)
  ensures  acc(x.f)
{
  x.f := 1
  assert x.f == 1
}

method calls_rejected(n: Int)
{
  uses_exists(n)
}
