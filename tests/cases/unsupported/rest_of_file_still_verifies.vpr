// One method uses a construct we do not implement; the other must still be
// verified, and the method that calls the rejected one must not be.
field f: Int

method uses_multiset(xs: Multiset[Int])
{
  assert true
}

method fine(x: Ref)
  requires acc(x.f)
  ensures  acc(x.f)
{
  x.f := 1
  assert x.f == 1
}

method calls_rejected(xs: Multiset[Int])
{
  uses_multiset(xs)
}
