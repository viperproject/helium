// A generic axiom is instantiated only at the types its trigger matches fix.
// `loose` mentions `T` only in `g(x)` inside the `forall`, whose trigger `h(x)`
// carries no type arguments, and the trigger stands in for the body: nothing
// fixes `T`. It is rejected as unsupported (`UntypedGenericAxiom`), and `m`,
// which depends on it, is skipped.
domain D[T] {
  function g(x: Int): D[T]
  function h(x: Int): Int

  axiom loose { forall x: Int :: { h(x) } g(x) == g(x) }
}

method m() {
  assert h(0) == h(0)
  assert (g(0): D[Int]) == g(0)
}
