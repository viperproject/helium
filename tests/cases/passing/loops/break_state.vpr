// Verifies through integer ranges: the invariant bounds `i` by `5`, so at the
// break `i + 1 > 5` pins `i + 1` to `6`. Silicon verifies it
// (`tests/cases/known_limitations/loops/ORACLE.md`).

// S4: an out edge carries the body's LIVE state and does NOT re-establish
// the invariant. `i <= 5` is violated at the break point, yet `i == 6` is
// provable afterwards.
method break_state() returns (i: Int)
{
    var n: Int := 10
    i := 0
    while (i < n)
        invariant i <= 5
    {
        i := i + 1
        if (i > 5) { goto brk }
    }
    label brk
    assert i == 6
}
