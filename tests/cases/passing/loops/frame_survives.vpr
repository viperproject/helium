// KNOWN LIMITATION: the loop cut works; this fails on the pre-existing
// integer-range arithmetic gap. The same obligation fails with no loop at
// all (`0 <= i && i <= n`, `assume i < n` |- `i + 1 <= n`), so nothing here
// is loop-specific. Silicon verifies this program.
// Tracking: design/loops/PLAN.md; project_panic_freedom_boundary (tier-C).

// The frame — everything the invariant does not mention — is preserved
// across the loop verbatim, values included. `other.f` is never named in the
// invariant and never touched by the body.
field f: Int

method frame_survives(n: Int) returns (i: Int)
  requires n >= 0
{
    var other: Ref
    other := new(f)
    other.f := 42
    i := 0
    while (i < n)
        invariant 0 <= i && i <= n
    { i := i + 1 }
    assert acc(other.f)
    assert other.f == 42
}
