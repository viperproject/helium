// KNOWN LIMITATION: a label declared inside a loop body cannot be named by
// `old[L]`. Typecheck's `collect_labels` (src/viper/typecheck/mod.rs) skips
// `while` bodies, so this is rejected with "label is not defined in this
// method" before verification. Silicon accepts it. Promote to
// passing/labels_in_loops/ once old[L] on loop labels is supported.

// A forward `goto` to a label later in the same loop body (a `continue`-like
// skip). Both paths reach `Skip`; the earlier label is still usable after it.
field f: Int

method goto_skip_within_body(x: Ref, n: Int, b: Bool)
  requires acc(x.f)
  ensures acc(x.f)
{
  var i: Int := 0
  while (i < n)
    invariant acc(x.f)
  {
    label Top
    if (b) { goto Skip }
    x.f := x.f + 1
    label Skip
    assert x.f == old[Top](x.f) || x.f == old[Top](x.f) + 1
    i := i + 1
  }
}
