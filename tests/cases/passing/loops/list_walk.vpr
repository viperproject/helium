// Verifies through integer ranges: `n >= 0` bounds `n + 1` below by `1`.
// Silicon verifies it (`tests/cases/known_limitations/loops/ORACLE.md`).

// S2: predicate traversal, no quantified permissions.
field next: Ref

predicate list(x: Ref) {
  acc(x.next) && (x.next != null ==> acc(list(x.next)))
}

method walk(x: Ref) returns (n: Int)
  requires x != null ==> acc(list(x))
  ensures  n >= 0
{
  var cur: Ref := x
  n := 0
  while (cur != null)
    invariant n >= 0
    invariant cur != null ==> acc(list(cur))
  {
    unfold acc(list(cur))
    n := n + 1
    cur := cur.next
  }
}
