// KNOWN LIMITATION: the loop cut works; this fails on the pre-existing
// integer-range arithmetic gap. The same obligation fails with no loop at
// all (`0 <= i && i <= n`, `assume i < n` |- `i + 1 <= n`), so nothing here
// is loop-specific. Silicon verifies this program.
// Tracking: design/loops/PLAN.md; project_panic_freedom_boundary (tier-C).

// S2: predicate traversal, no quantified permissions.
field next: Ref

predicate list(x: Ref) {
  acc(x.next) && (x.next != null ==> acc(list(x.next)))
}

method walk(x: Ref) returns (n: Int)
  requires x != null ==> acc(list(x))
  ensures  n >= 0
{
  var cur: Ref := x
  n := 0
  while (cur != null)
    invariant n >= 0
    invariant cur != null ==> acc(list(cur))
  {
    unfold acc(list(cur))
    n := n + 1
    cur := cur.next
  }
}
