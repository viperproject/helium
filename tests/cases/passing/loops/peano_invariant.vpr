// The invariant is load-bearing: `s` is written by the body, so it is havoc'd
// at the cut, and the postcondition is unprovable without carrying `!s.isZero`
// across. Every step is a constructor/tester reduction — no integer reasoning.
adt Nat {
    Zero()
    Succ(pred: Nat)
}

method stays_succ(n: Nat) returns (s: Nat)
  ensures !s.isZero
{
    s := Succ(n)
    var c: Nat := n
    while (!c.isZero)
      invariant !s.isZero
    {
        c := c.pred
        s := Succ(s)
    }
}
