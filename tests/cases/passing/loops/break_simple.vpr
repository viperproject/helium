// KNOWN LIMITATION: `break` itself works (see passing/loops/peano_break.vpr).
// This fails on the pre-existing integer-range arithmetic gap in its
// invariant, exactly like the other integer loop cases. Silicon verifies it.
// Tracking: design/loops/PLAN.md; project_panic_freedom_boundary (tier-C).

// S4: `break` — a goto out of the loop body. Needs stages 5-6
// (HeapInst::Union + post-loop confluence), so this lands in
// known_limitations for the stages 0-4 branch.
field f: Int

method break_simple() returns (i: Int)
{
    var box: Ref
    box := new(f)
    box.f := 10
    i := 0
    while (i < box.f)
        invariant acc(box.f, wildcard)
        invariant i <= box.f
    {
        i := i + 1
        if (i > 5) { goto brk }
    }
    label brk
    assert box.f == 10
}
