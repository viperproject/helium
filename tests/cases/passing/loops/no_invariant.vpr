// KNOWN LIMITATION: the loop cut works; this fails on the pre-existing
// integer-range arithmetic gap. The same obligation fails with no loop at
// all (`0 <= i && i <= n`, `assume i < n` |- `i + 1 <= n`), so nothing here
// is loop-specific. Silicon verifies this program.
// Tracking: design/loops/PLAN.md; project_panic_freedom_boundary (tier-C).

// S12: back edge to a head carrying no invariant. The body heap is empty,
// so nothing about the pre-loop state survives. Silicon accepts the program
// but cannot prove the assertion.
method no_invariant(n: Int) returns (i: Int)
  requires n >= 0
{
    i := 0
    label head
    if (i < n) {
        i := i + 1
        goto head
    }
    assert i >= 0
}
