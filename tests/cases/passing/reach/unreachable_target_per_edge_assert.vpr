// Regression: an assert in a block reached by several edges, none of whose
// literals are common to all of them (per-edge assert distribution in
// lower_method).
//
// `dead` is the shared miss target of two chain-decoded matches, on `a` and on
// `b` — Prusti's shared unreachable `match` arm. Its reach is
// `(a != 0 && a != 1) || (reach(s2) && b != 0 && b != 1)`: no literal is
// implied, so the pc is one opaque literal that only case analysis refutes.
// The assert is checked once per incoming edge instead, under that edge's own
// pc, and each copy contradicts a precondition.
method m(a: Int, b: Int)
  requires a == 0 || a == 1
  requires b == 0 || b == 1
{
  if (a == 0) { goto s2 } else { goto a1 }
  label a1
  if (a == 1) { goto s2 } else { goto dead }
  label s2
  if (b == 0) { goto end } else { goto b1 }
  label b1
  if (b == 1) { goto end } else { goto dead }
  label dead
  assert false
  label end
}
