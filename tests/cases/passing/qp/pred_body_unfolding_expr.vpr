// A QP over a two-argument predicate with a body: an `unfolding` of one
// instance reads its body, and the value is the same on a second read.
field f: Int
field g: Int

// Owns the first argument's `f` and the second argument's `g`.
predicate P(x: Ref, y: Ref) {
  acc(x.f) && acc(y.g)
}

method pred_body_unfolding_expr(s: Set[Ref], t: Set[Ref], a: Ref, b: Ref)
  requires a in s && b in t
{
  inhale forall x: Ref, y: Ref :: x in s && y in t ==> acc(P(x, y))
  assert (unfolding acc(P(a, b)) in a.f) == (unfolding acc(P(a, b)) in a.f)
}
