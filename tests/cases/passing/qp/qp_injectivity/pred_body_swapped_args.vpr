// QP injectivity over a two-argument predicate with a body whose arguments are
// the binders in swapped order.
field f: Int
field g: Int

// Owns the first argument's `f` and the second argument's `g`.
predicate P(x: Ref, y: Ref) {
  acc(x.f) && acc(y.g)
}

method pred_body_swapped_args(s: Set[Ref], t: Set[Ref])
{
  inhale forall x: Ref, y: Ref :: x in s && y in t ==> acc(P(y, x))
}
