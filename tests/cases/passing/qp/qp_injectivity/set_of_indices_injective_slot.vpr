// QP injectivity over a set of indices: membership in `is` alone proves
// nothing about receivers, but `slot(a, i)` is injective in `i` by its axiom.
field f: Int

domain Array {
  function slot(a: Array, i: Int): Ref
  function index(r: Ref): Int

  axiom slot_index {
    forall a: Array, i: Int :: { slot(a, i) } index(slot(a, i)) == i
  }
}

method set_of_indices_injective_slot(a: Array, is: Set[Int])
{
  inhale forall i: Int :: i in is ==> acc(slot(a, i).f)
}
