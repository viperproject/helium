// A binder-free heap-dependent call under `old` inside a `forall` in a method
// postcondition: framed against, and read from, the pre-state heap.
//
// Shape of Prusti's `memory_block_join$struct$..` (marco_benchmark Ru2 suite;
// formerly `known_limitations/marco_benchmark/old_in_quantifier.vpr`).
//
// Must VERIFY.
predicate MB(a: Ref)

function bytes(a: Ref): Int
  requires acc(MB(a), wildcard)

function to_bytes(s: Int): Int

method join(a: Ref)
  requires acc(MB(a))
  ensures acc(MB(a))
  ensures forall s: Int :: { to_bytes(s) }
    old(bytes(a) == to_bytes(s)) ==> bytes(a) == to_bytes(s)

method client(a: Ref)
  requires acc(MB(a))
  requires bytes(a) == to_bytes(3)
{
  join(a)
  assert bytes(a) == to_bytes(3)
}
