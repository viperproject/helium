// QP medium (branch join): both branches exhale from the same chunk set, but
// different amounts. A later exhale of the smaller remainder must still find
// enough on both paths.
//
// Must VERIFY.
field f: Int

method join_exhale_both_amounts(s: Set[Ref], a: Ref, c: Bool)
  requires forall x: Ref :: x in s ==> acc(x.f)
  requires a in s
{
  if (c) {
    exhale forall x: Ref :: x in s ==> acc(x.f, 1/2)
  } else {
    exhale forall x: Ref :: x in s ==> acc(x.f, 1/4)
  }
  assert perm(a.f) == (c ? 1/2 : 3/4)
  exhale forall x: Ref :: x in s ==> acc(x.f, 1/2)
  assert perm(a.f) == (c ? none : 1/4)
}
