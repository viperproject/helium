// QP medium: repeated exhales that no single set covers (taken from both sets
// together, `take_spread`). Each records a `Taken::Share` debit that is
// evaluated from amounts only; defining values there (handovers) made every
// further exhale multiply the cost (54 s for these six).
//
// Must VERIFY.
field f: Int

method many(s: Set[Ref], t: Set[Ref], a: Ref)
  requires forall x: Ref :: x in s ==> acc(x.f, 1/2)
  requires forall x: Ref :: x in t ==> acc(x.f, 1/2)
  requires s intersection t == Set[Ref]()
  requires a in s
{
  exhale forall x: Ref :: x in (s union t) ==> acc(x.f, 1/16)
  exhale forall x: Ref :: x in (s union t) ==> acc(x.f, 1/16)
  exhale forall x: Ref :: x in (s union t) ==> acc(x.f, 1/16)
  exhale forall x: Ref :: x in (s union t) ==> acc(x.f, 1/16)
  exhale forall x: Ref :: x in (s union t) ==> acc(x.f, 1/16)
  exhale forall x: Ref :: x in (s union t) ==> acc(x.f, 1/16)
  assert a.f == a.f
}
