// QP medium: two chunk sets each hold half of the same location; both shares
// are positive, so both maps hold the one value there.
//
// The precondition's `a.f == 3` names one set's map only. Its certificate walk
// records that both sets hold `a` positively, so the maps agree there, and the
// method entry assumes that agreement; after the exhale `t`'s map still reads 3.
// (`two_half_sets_read_agree` reads with both sets held, outside a certificate.)
//
// Must VERIFY.
field f: Int

method two_half_sets_agree(s: Set[Ref], t: Set[Ref], a: Ref)
  requires forall x: Ref :: x in s ==> acc(x.f, 1/2)
  requires forall x: Ref :: x in t ==> acc(x.f, 1/2)
  requires a in s && a in t
  requires a.f == 3
{
  exhale forall x: Ref :: x in s ==> acc(x.f, 1/2)
  assert a.f == 3
}
