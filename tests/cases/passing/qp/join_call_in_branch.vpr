// QP medium (branch join): a call in one branch consumes and re-produces the
// chunk set (a fresh value map on that path only).
//
// Must VERIFY.
field f: Int

method callee(s: Set[Ref])
  requires forall x: Ref :: x in s ==> acc(x.f)
  ensures forall x: Ref :: x in s ==> acc(x.f)

method join_call_in_branch(s: Set[Ref], a: Ref, c: Bool)
  requires forall x: Ref :: x in s ==> acc(x.f)
  requires a in s
  ensures forall x: Ref :: x in s ==> acc(x.f)
{
  if (c) {
    callee(s)
  }
  a.f := 5
  assert a.f == 5
}
