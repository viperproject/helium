// QP medium (loop exit / heap sum): nested loops. The inner invariant takes
// only half of the chunk set, so the sum at the inner exit runs inside the
// outer body, whose own heap came from the outer invariant.
//
// Must VERIFY.
field f: Int

method loop_nested(s: Set[Ref], a: Ref, n: Int)
  requires forall x: Ref :: x in s ==> acc(x.f)
  requires a in s && 0 <= n
{
  var i: Int := 0
  while (i < n)
    invariant 0 <= i && i <= n
    invariant forall x: Ref :: x in s ==> acc(x.f)
  {
    var j: Int := 0
    while (j < i)
      invariant 0 <= j && j <= i
      invariant forall x: Ref :: x in s ==> acc(x.f, 1/2)
    {
      j := j + 1
    }
    a.f := i
    i := i + 1
  }
  assert perm(a.f) == write
}
