// QP medium: one arm exhales the chunk set; a read on the other path is still
// framed.
//
// Must VERIFY.
field f: Int

method branch_exhale_one_arm_guarded(s: Set[Ref], a: Ref, b: Bool)
  requires forall x: Ref :: x in s ==> acc(x.f)
  requires a in s
{
  if (b) { exhale forall x: Ref :: x in s ==> acc(x.f) }
  if (!b) { var v: Int := a.f }
}
