// A quantified field permission in a method precondition whose trigger is a
// field read `{ r.v }`. The trigger matches the location term `v(r)` that every
// read of `r.v` builds.
//
// Seen in Prusti's `Vec` / `ArrayList` methods and in the PVL kernels under
// `Vi/viper/quantifiedpermissions/third_party` (formerly a marco_benchmark
// known limitation).
//
// Must VERIFY.
field v: Int

method m(s: Set[Ref], x: Ref)
  requires forall r: Ref :: { r.v } r in s ==> acc(r.v)
  requires x in s
{
  x.v := 1
}
