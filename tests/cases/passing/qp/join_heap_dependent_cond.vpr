// QP medium (branch join): the branch condition itself reads a member of the
// chunk set.
//
// Must VERIFY.
field f: Int

method join_heap_dependent_cond(s: Set[Ref], a: Ref)
  requires forall x: Ref :: x in s ==> acc(x.f)
  requires a in s
{
  if (a.f > 0) {
    a.f := 0
  }
  assert a.f <= 0
}
