// A QP over a two-argument predicate with a body: a value written while one
// instance is unfolded is seen through `unfolding` after it is folded back.
field f: Int
field g: Int

// Owns the first argument's `f` and the second argument's `g`.
predicate P(x: Ref, y: Ref) {
  acc(x.f) && acc(y.g)
}

method pred_body_fold_keeps_value(s: Set[Ref], t: Set[Ref], a: Ref, b: Ref)
  requires a in s && b in t
{
  inhale forall x: Ref, y: Ref :: x in s && y in t ==> acc(P(x, y))
  unfold acc(P(a, b))
  a.f := 5
  fold acc(P(a, b))
  assert (unfolding acc(P(a, b)) in a.f) == 5
}
