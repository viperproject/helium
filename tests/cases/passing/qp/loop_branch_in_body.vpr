// QP medium (loop exit + branch join): the loop body branches on a member of
// the chunk set, so it needs the join inside the body and the sum at the exit.
//
// Must VERIFY.
field f: Int

method loop_branch_in_body(s: Set[Ref], a: Ref, n: Int)
  requires forall x: Ref :: x in s ==> acc(x.f)
  requires a in s && a.f == 0 && 0 <= n
{
  var i: Int := 0
  while (i < n)
    invariant 0 <= i && i <= n
    invariant forall x: Ref :: x in s ==> acc(x.f)
    invariant 0 <= a.f && a.f <= 10
  {
    if (a.f < 10) {
      a.f := a.f + 1
    }
    i := i + 1
  }
  assert a.f <= 10
}
