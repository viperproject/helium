// A QP over a two-argument predicate with a body, inhaled and exhaled as a
// whole.
field f: Int
field g: Int

// Owns the first argument's `f` and the second argument's `g`.
predicate P(x: Ref, y: Ref) {
  acc(x.f) && acc(y.g)
}

method pred_body_exhale_all(s: Set[Ref], t: Set[Ref])
{
  inhale forall x: Ref, y: Ref :: x in s && y in t ==> acc(P(x, y))
  exhale forall x: Ref, y: Ref :: x in s && y in t ==> acc(P(x, y))
}
