// suite: no-z3
// A tester of an `ite` whose arms both satisfy it: `isC(b ? s : t)` with `s`
// and `t` both `C`. With `b` undecided, `ConstFold` gives the `ite` the union of
// its arms' variant sets, here `{C}`, so `is-*` decides the tester without a
// case split on `b`. The `ite` comes from a function body.
adt Shape {
    Circle(radius: Int)
    Square(side: Int)
    Tri(base: Int, height: Int)
}

function pick(b: Bool, s: Shape, t: Shape): Shape
{
    b ? s : t
}

method tester_through_function_ite(b: Bool, s: Shape, t: Shape)
    requires s.isCircle && t.isCircle
{
    assert pick(b, s, t).isCircle
    assert !pick(b, s, t).isTri
}
