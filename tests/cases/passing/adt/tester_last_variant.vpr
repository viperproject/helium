// suite: no-z3
// Last-variant reasoning on an opaque value (`is-excl-*`): when every tester but
// one is false, the remaining one is true, and the testers are exhaustive.
// All-false and single-variant ADTs are in `known_limitations/adt/`.
adt Shape {
    Circle(radius: Int)
    Square(side: Int)
    Tri(base: Int, height: Int)
}

adt Suit {
    Hearts()
    Diamonds()
    Clubs()
    Spades()
}

adt Opt {
    NoneI()
    SomeI(val: Int)
}

method last_variant_two(o: Opt)
{
    assume !o.isNoneI
    assert o.isSomeI
}

method last_variant_two_other_side(o: Opt)
{
    assume !o.isSomeI
    assert o.isNoneI
}

// Each of the three variants can be the last one standing.
method last_variant_first(s: Shape)
{
    assume !s.isSquare
    assume !s.isTri
    assert s.isCircle
}

method last_variant_middle(s: Shape)
{
    assume !s.isCircle
    assume !s.isTri
    assert s.isSquare
}

method last_variant_four(c: Suit)
{
    assume !c.isHearts
    assume !c.isSpades
    assume !c.isDiamonds
    assert c.isClubs
}

// The negations come in one conjunction.
method last_variant_conjunction(c: Suit)
{
    assume !c.isHearts && !c.isDiamonds && !c.isClubs
    assert c.isSpades
}

// The negations come from preconditions.
method last_variant_from_precondition(s: Shape)
    requires !s.isCircle
    requires !s.isSquare
    ensures s.isTri
{
}

method exhaustive_four(c: Suit)
{
    assert c.isHearts || c.isDiamonds || c.isClubs || c.isSpades
}

method exhaustive_two(o: Opt)
{
    assert o.isNoneI || o.isSomeI
}

// One negation leaves a disjunction of the rest.
method one_negation_leaves_disjunction(s: Shape)
{
    assume !s.isTri
    assert s.isCircle || s.isSquare
}

// The last-variant fact feeds a branch: only the else branch is reachable.
method last_variant_prunes_branch(s: Shape) returns (r: Int)
    requires !s.isCircle && !s.isTri
    ensures r == 2
{
    if (s.isSquare) {
        r := 2
    } else {
        r := 99
        assert false
    }
}

