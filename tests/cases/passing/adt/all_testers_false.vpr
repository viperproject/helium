// suite: no-z3
// Every tester of a value false is a contradiction: the testers are exhaustive.
// `variant-narrow-*` removes one variant per false tester from the value's
// variant set; with every variant removed the set is empty and the class
// `Inconsistent`. A single-variant ADT is the degenerate case: its only tester
// false is already "all false". All-but-one false (the last one becomes true) is
// in `tester_last_variant.vpr`.
adt Shape {
    Circle(radius: Int)
    Square(side: Int)
    Tri(base: Int, height: Int)
}

adt Suit {
    Hearts()
    Diamonds()
    Clubs()
    Spades()
}

adt Single {
    Only(content: Int)
}

method all_false_three(s: Shape)
{
    assume !s.isCircle
    assume !s.isSquare
    assume !s.isTri
    assert false
}

method all_false_four(c: Suit)
{
    assume !c.isHearts && !c.isDiamonds && !c.isClubs && !c.isSpades
    assert false
}

method single_variant_negated_is_false(x: Single)
{
    assume !x.isOnly
    assert false
}
