// suite: no-z3
// Constructor injectivity `C(a..) == C(b..) ==> a_i == b_i`, with and without a
// projection over the terms. Without a projection, congruence cannot recover
// the component equalities, so these exercise the accessor terms that
// `accessor-*` adds for every constructor application, not `proj-*`.
adt Shape {
    Circle(radius: Int)
    Square(side: Int)
    Tri(base: Int, height: Int)
}

adt Lst {
    Nil()
    Cons(head: Int, tail: Lst)
}

adt Flag {
    Mk(on: Bool, level: Int)
}

method inj_unary(x: Int, y: Int)
{
    assume Circle(x) == Circle(y)
    assert x == y
}

method inj_binary(a: Int, b: Int, c: Int, d: Int)
{
    assume Tri(a, b) == Tri(c, d)
    assert a == c
    assert b == d
}

// Both constructor terms reach one class through a shared variable.
method inj_via_shared_variable(s: Shape, a: Int, b: Int, c: Int, d: Int)
{
    assume s == Tri(a, b)
    assume s == Tri(c, d)
    assert a == c
    assert b == d
}

// Injectivity against literals pins the variables.
method inj_against_literals(a: Int, b: Int)
{
    assume Tri(a, b) == Tri(1, 2)
    assert a == 1
    assert b == 2
}

// Swapped arguments: both components equal each other.
method inj_swapped(a: Int, b: Int)
{
    assume Tri(a, b) == Tri(b, a)
    assert a == b
}

method inj_bool_component(p: Bool, k: Int)
{
    assume Mk(p, k) == Mk(true, 3)
    assert p
    assert k == 3
}

// The recursive component is unified, not just the head.
method inj_recursive_tail(x: Int, y: Int, xs: Lst, ys: Lst)
{
    assume Cons(x, xs) == Cons(y, ys)
    assert x == y
    assert xs == ys
}

// Injectivity has to fire at every level of a nested term.
method inj_nested(x: Int, y: Int, z: Int)
{
    assume Cons(x, Cons(y, Cons(z, Nil()))) == Cons(1, Cons(2, Cons(3, Nil())))
    assert x == 1
    assert y == 2
    assert z == 3
}

// Component equality transfers facts about the component.
method inj_transfers_tester(x: Int, y: Int, xs: Lst, ys: Lst)
{
    assume Cons(x, xs) == Cons(y, ys)
    assume xs.isNil
    assert ys.isNil
    assert !ys.isCons
}

method inj_transfers_arith(a: Int, b: Int, c: Int, d: Int)
{
    assume Tri(a, b) == Tri(c, d)
    assume a > 10
    assert c > 10
}

// Contrapositive: different components give different values.
method inj_contrapositive_literals()
{
    assert Circle(1) != Circle(2)
    assert Tri(1, 2) != Tri(1, 3)
}

method inj_contrapositive_symbolic(a: Int, b: Int, c: Int, d: Int)
{
    assume a != c
    assert Tri(a, b) != Tri(c, d)
}

// Equal components give equal values (congruence, the converse direction).
method congruence(a: Int, b: Int, c: Int, d: Int)
{
    assume a == c && b == d
    assert Tri(a, b) == Tri(c, d)
}

// Injectivity through a method postcondition.
method mk(a: Int, b: Int) returns (s: Shape)
    ensures s == Tri(a, b)
{
    s := Tri(a, b)
}

method inj_through_call(a: Int, b: Int, c: Int, d: Int)
{
    var s: Shape
    var t: Shape
    s := mk(a, b)
    t := mk(c, d)
    assume s == t
    assert a == c && b == d
}
