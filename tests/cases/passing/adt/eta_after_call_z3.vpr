adt Lst {
    Nil()
    Cons(head: Int, tail: Lst)
}

adt Shape {
    Circle(radius: Int)
    Square(side: Int)
}

method prepend(x: Int, l: Lst) returns (r: Lst)
    ensures r.isCons && r.head == x && r.tail == l
{
    r := Cons(x, l)
}

method use_prepend(l: Lst)
{
    var r: Lst
    r := prepend(7, l)
    assert r == Cons(7, l)
}

method grow(s: Shape) returns (t: Shape)
    requires s.isCircle
    ensures t.isCircle && t.radius == s.radius + 1
{
    t := Circle(s.radius + 1)
}

method use_grow(r: Int)
{
    var t: Shape
    t := grow(Circle(r))
    assert t == Circle(r + 1)
}

// The same facts by `assume` verify today.
method eta_by_assume(r: Lst, l: Lst)
{
    assume r.isCons && r.head == 7 && r.tail == l
    assert r == Cons(7, l)
}
