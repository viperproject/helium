// A quantifier in a predicate body reading a field the body holds. The read
// mentions no binder, so it is evaluated in the body's own heap after the
// `acc`; unfolding the predicate releases the quantifier over that value.
// Silicon verifies this.

field f: Int

domain D {
  function t(i: Int): Bool
}

predicate Big(x: Ref) {
  acc(x.f) && forall i: Int :: { t(i) } t(i) ==> x.f > i
}

method m(x: Ref)
  requires acc(Big(x))
{
  unfold acc(Big(x))
  assume t(10)
  assert x.f > 10
}
