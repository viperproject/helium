// From the PR 4 review (reassert.vpr, `r1`): must verify.

domain D { function f(x: Int): Int }
function g(x: Int): Int
  requires x > 0
{ x + 1 }
function h(x: Int): Bool
{ x > 3 }





// heap: arm inhales permission + value; after join use under arm cond (PASS)
field val: Int

// token released in an arm (call under c); after join, the definitional
// axiom must be usable under c. PASS expected.
method r1(x: Int, z: Int, c: Bool)
{
  if (x == z) { assert f(x) == f(z) }
  if (c) {
    inhale x > 0
    assert g(x) == x + 1
  }
  assert c ==> g(x) == x + 1
}
