// Once a method has a working graph the rules run there and ground keeps only its
// terminating reductions. Address equalities only ground's rules would have
// derived reach the heap from the working graph, as conditional (pc-alias)
// matches, also where the path condition is empty.
field f: Int

domain D {
  function g(x: Int): Int
  function same(r: Ref): Ref
  function whole(p: Perm): Perm
  axiom same_is_identity { forall r: Ref :: { same(r) } same(r) == r }
  axiom whole_is_identity { forall p: Perm :: { whole(p) } whole(p) == p }
}

// The first branch gives the method its working graph. `same(x)` meets `x` only
// through the axiom, an instance only the working graph builds from then on.
method unconditional(x: Ref, z: Int)
  requires acc(x.f)
{
  if (z == 3) { assert g(z) == g(3) }
  exhale acc(same(x).f)
}

// A wildcard share taken through such a match comes off that chunk directly: a
// summarized consume proves a fixed amount, which a wildcard is not.
method unconditional_wildcard(x: Ref, z: Int)
  requires acc(x.f, 1/2)
{
  if (z == 3) { assert g(z) == g(3) }
  exhale acc(same(x).f, wildcard)
  exhale acc(x.f, wildcard)
}

// The read finds the chunk through the working graph although the path
// condition is empty (main misses it: its ground probe only runs under a pc).
method unconditional_read(x: Ref, z: Int)
  requires acc(x.f) && x.f == 4
{
  if (z == 3) { assert g(z) == g(3) }
  assert same(x).f == 4
}

// The same address meeting only under the branch: consumed through the guarded
// debit there, so the other path keeps its permission.
method conditional(x: Ref, y: Ref, c: Bool, z: Int)
  requires acc(x.f, 1/2) && acc(y.f, 1/2)
{
  if (z == 3) { assert g(z) == g(3) }
  if (c) {
    inhale x == y
    exhale acc(y.f, 1/1)
  } else {
    exhale acc(y.f, 1/2)
  }
}

// The chunk the working graph matches is drained on both arms, by an amount equal
// to all of it only through an axiom (so its permission stays a term), and the
// permission is back in chunks given back there, at addresses equal to the demand
// only under each arm's condition. The group summary still gets its turn, as it
// does after a ground match.
method given_back_on_both_arms(x: Ref, y: Ref, w: Ref, c: Bool, z: Int)
  requires acc(x.f)
{
  if (z == 3) { assert g(z) == g(3) }
  if (c) {
    exhale acc(same(x).f, whole(1/1))
    inhale y == x
    inhale acc(y.f)
  } else {
    exhale acc(same(x).f, whole(1/1))
    inhale w == x
    inhale acc(w.f)
  }
  exhale acc(same(x).f)
}
