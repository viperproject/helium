// A fact an arm inhales, and what nested arms prove from it, is usable after
// the join under the arm's condition. The first `if` builds the working graph
// before the branch.
//
// Must verify.

domain D { function f(x: Int): Int }

method r2(x: Int, z: Int, c: Bool, d: Bool)
{
  if (x == z) { assert f(x) == f(z) }
  if (c) {
    inhale f(x) == 2
    if (d) { assert f(x) > 1 } else { assert f(x) < 3 }
  }
  assert c ==> f(x) == 2
}
