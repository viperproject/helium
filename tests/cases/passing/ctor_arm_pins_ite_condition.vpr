// `ite-reduce`'s arm-differs pinning at ADT constructors, not just literals.
//
// The class's value is pinned to one constructor; an arm pinned to a *different*
// constructor of the same ADT cannot be the one taken, so the condition is
// pinned to the other side. Free constructors are what makes this sound — the
// same premise `ConstFold` uses to fold a `Ctor == Ctor` comparison to `false`
// and to declare a two-constructor class inconsistent.
//
// The negative half (identical arms and the arm that *does* match) lives in
// `failing/ctor_ite_identical_arms_pin_nothing.vpr` and
// `failing/ctor_ite_matching_arm_pins_no_polarity.vpr`. Same-constructor arms with differing
// payloads entail the condition by injectivity, so that case is in
// `passing/ctor_ite_same_ctor_arms_pin_nothing.vpr`.

adt SH { c0() c1(x: Int) }

// else-arm differs => condition pinned true
method then_arm_matches(b: Bool)
{
  assume (b ? c1(7) : c0()) == c1(7)
  assert b
}

// then-arm differs => condition pinned false
method else_arm_matches(b: Bool, k: Int)
{
  assume (b ? c1(k) : c0()) == c0()
  assert !b
}

// both arms differ => the two pins contradict, which is the right answer:
// an `ite` equal to something neither arm can be is unsatisfiable
method both_arms_differ(b: Bool, k: Int)
{
  assume (b ? c1(k) : c1(k)) == c0()
  assert false
}
