// The block-scratch union replay in an else-arm: `assert !b` builds that
// block's scratch, and the callee's postcondition `r == g(x)` unfolds in ground
// afterwards. Fails on main.
// Canary: `failing/block_scratch_replay_sibling_arm.vpr`.

function g(x: Int): Int { x + 1 }

method callee(x: Int) returns (r: Int)
  ensures r == g(x)

method p_else(b: Bool, x: Int)
{
  var r: Int
  if (b) {
    assert b
    r := callee(x)
  } else {
    assert !b
    r := callee(x)
    assert r == x + 1
  }
}
