// Map: the algebra of update, and `domain`/`range` as sets.

method update_overwrites(m: Map[Int, Int], k: Int) {
  assert m[k := 1][k := 2] == m[k := 2]
}

method updates_on_distinct_keys_commute(m: Map[Int, Int], j: Int, k: Int)
  requires j != k
{
  assert m[j := 1][k := 2] == m[k := 2][j := 1]
}

method update_with_own_value(m: Map[Int, Int], k: Int)
  requires k in m
{
  assert m[k := m[k]] == m
}

method update_is_never_empty(m: Map[Int, Int], k: Int) {
  assert |m[k := 0]| > 0
}

method domain_grows(m: Map[Int, Int], k: Int) {
  assert domain(m) subset domain(m[k := 0])
}

method range_after_update(m: Map[Int, Int], k: Int, v: Int) {
  assert m[k := v][k] in range(m[k := v])
  assert v in range(m[k := v])
}

method equal_maps_agree(a: Map[Int, Int], b: Map[Int, Int], k: Int)
  requires a == b && k in a
{
  assert k in b
  assert a[k] == b[k]
  assert domain(a) == domain(b)
  assert range(a) == range(b)
}

method key_membership_from_domain(m: Map[Int, Int], k: Int)
  requires k in domain(m)
{
  assert k in m
  var v: Int := m[k]
}
