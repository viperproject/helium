// Positive controls for `failing/scratch_guard_*`: the facts an `unfolding` under an
// intra-block condition `b` reveals still hold where `b` does.
field f: Int
predicate Q(r: Ref, v: Int) { acc(r.f) && v == 5 }

method unfolding_ternary(x: Ref, y: Ref, v: Int, b: Bool, c: Bool)
  requires acc(x.f, 1/2) && acc(y.f, 1/2) && (c ==> x == y)
  requires b ==> Q(y, v)
{
  exhale c ==> acc(x.f)
  var t: Int := b ? (unfolding Q(y, v) in 1) : 0
  assert b ==> v == 5
}

method unfolding_exhale(x: Ref, y: Ref, v: Int, b: Bool, c: Bool)
  requires acc(x.f, 1/2) && acc(y.f, 1/2) && (c ==> x == y)
  requires b ==> Q(y, v)
{
  exhale c ==> acc(x.f)
  exhale b ==> (unfolding Q(y, v) in true)
  assert b ==> v == 5
}

method unfolding_inhale(x: Ref, y: Ref, v: Int, b: Bool, c: Bool)
  requires acc(x.f, 1/2) && acc(y.f, 1/2) && (c ==> x == y)
  requires b ==> Q(y, v)
{
  exhale c ==> acc(x.f)
  inhale b ==> (unfolding Q(y, v) in true)
  assert b ==> v == 5
}

method unfolding_in_assertion(x: Ref, y: Ref, v: Int, b: Bool, c: Bool)
  requires acc(x.f, 1/2) && acc(y.f, 1/2) && (c ==> x == y)
  requires b ==> Q(y, v)
{
  exhale c ==> acc(x.f)
  assert b ==> unfolding Q(y, v) in v == 5
}

method unfolding_in_branch_on_its_condition(x: Ref, y: Ref, v: Int, b: Bool, c: Bool)
  requires acc(x.f, 1/2) && acc(y.f, 1/2) && (c ==> x == y)
  requires b ==> Q(y, v)
{ exhale c ==> acc(x.f)
  if (b) {
    var t: Int := b ? (unfolding Q(y, v) in 1) : 0
    assert v == 5 } }

method unfolding_ternary_reviewer(x: Ref, y: Ref, v: Int, b: Bool, c: Bool)
  requires acc(x.f, 1/2) && acc(y.f, 1/2) && (c ==> x == y)
  requires b ==> Q(y, v)
{ exhale c ==> acc(x.f)
  var t: Int := b ? (unfolding Q(y, v) in 1) : 0
  assert b ==> v == 5 }
