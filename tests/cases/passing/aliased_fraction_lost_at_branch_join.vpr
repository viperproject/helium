// Must VERIFY. Was a known limitation (`known_limitations/marco_benchmark/`):
// "insufficient permission" on the final
// `exhale acc(T(b0), p)`.
//
// `take1` returns `l0 == intersect(Set(b0))`, which the axiom makes `b0`, so
// after it the full `p` at `T(b0)` is held again, split over two chunks.
// `take`/`give` remove and return `p / 6` of it. Without the empty `if (c) {}`,
// or without `take1`, the method verifies: the join after the branch loses
// the fact that the chunk returned by `take1` aliases `T(b0)`.
//
// Reduced from Prusti's lifetime-token bookkeeping (`lft_tok_sep_take$1/2`,
// `lft_tok_sep_return$2`, axiom `intersect_singleton$`) in 083/pair.rs
// `core::cmp::max` (Ru2 suite). 044/enums.rs `test2`, 048/loops.rs `test19` and
// 072/map_contains.rs `test5` fail at the same instruction (the closing
// `exhale acc(LifetimeToken(..))`), presumably for the same reason; 7 of the
// 838 listed files in all.
domain Lft {
  function intersect(s: Set[Ref]): Ref

  axiom {
    forall l: Ref :: { intersect(Set(l)) } intersect(Set(l)) == l
  }
}

predicate T(l: Ref)

method take1(l1: Ref, p: Perm) returns (l: Ref)
  requires none < p && acc(T(l1), p)
  ensures acc(T(l), p) && l == intersect(Set(l1))

method take(l1: Ref, p: Perm)
  requires none < p && acc(T(l1), p)

method give(l1: Ref, p: Perm)
  requires none < p
  ensures acc(T(l1), p)

method m(b0: Ref, p: Perm, c: Bool)
  requires none < p && acc(T(b0), p)
{
  var l0: Ref
  l0 := take1(b0, p / 6)
  take(b0, p / 6)
  if (c) {}
  give(b0, p / 6)
  exhale acc(T(b0), p)
}
