// Verifies through the Z3 rung, not through integer ranges: e-graph saturation
// alone (ranges included) still rejects it. The range of an undecided `ite` is
// the hull of its arms' ranges, each arm taken whole. Here an arm is only
// reached where the condition holds — `level` in the inner else-arm is `>= 0`,
// and below `11` under the outer one — but the analysis does not narrow an arm
// by its condition: that would read the condition's operands, which are not
// the `ite`'s children, so the range would not be re-derived when they change
// (order-dependent). Silicon verifies this too (miniz
// `create_comp_flags_from_zip_params`).
// Unsound twins: `tests/cases/failing/intervals/clamp_upper.vpr`,
// `wrong_arm.vpr`.

method clamp(level: Int)
{
  var r: Int := level > 10 ? 10 : (level >= 0 ? level : 6)
  assert 0 <= r && r < 11
}
