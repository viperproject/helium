// A recursive call whose conditional precondition `t != null ==> acc(tree(t))`
// is reached where the path condition leaves `t.left != null` open. The call's
// snapshot member is `t.left != null ? Some(v) : None`: its value is read under
// that presence, and the certificate mirrors the member as that `ite`, so the
// definitional axiom names the snapshot every caller builds. `m` then needs the
// axiom: unfolding and re-folding `tree(t)` alone does not give back an equal
// snapshot.
//
// Reduced from `Go/gobra/.../tour/Tree.gobra` and `.../evaluation/binary_tree.gobra`
// (`deleteLeftMost`): Gobra encodes `nil`-able pointers this way.
field left: Ref
field val: Int

predicate tree(t: Ref) {
  acc(t.left) && acc(t.val) && (t.left != null ==> acc(tree(t.left)))
}

function contains(t: Ref, v: Int): Bool
  requires t != null ==> acc(tree(t))
{
  t != null && (unfolding acc(tree(t)) in t.val == v || contains(t.left, v))
}

method m(t: Ref, v: Int)
  requires t != null && acc(tree(t)) && !contains(t, v)
{
  unfold acc(tree(t))
  fold acc(tree(t))
  assert !contains(t, v)
}
