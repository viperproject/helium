// A function's precondition obligation under a path condition: on the `n == 0`
// arm, the multi-pattern chain `{g(i), h(i)}` from `g(n)` and `h(0)` reaches
// `g(15)`. Only a probe that assumes `n == 0` can build the chain, so the
// probe's depth, not ground's, decides the obligation.
domain G {
  function g(i: Int): Bool
  function h(i: Int): Bool
  axiom step { forall i: Int :: { g(i), h(i) } (g(i) == g(i + 1)) && (h(i) == h(i + 1)) }
}

function need(i: Int): Int
  requires g(i)
{ 0 }

function caller(n: Int): Int
  requires g(n) && h(0)
{ n == 0 ? need(15) : 0 }
