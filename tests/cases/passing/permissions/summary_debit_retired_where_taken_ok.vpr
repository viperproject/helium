// Passing counterpart of failing/permissions/summary_debit_retired_where_taken.vpr:
// the summarized consume of `acc(r.f)` leaves, on each path, exactly the location
// `r` is not.

field f: Int

method m(x: Ref, y: Ref, b: Bool)
    requires acc(x.f) && acc(y.f)
{
    var r: Ref
    if (b) { r := x } else { r := y }
    exhale acc(r.f)
    exhale b ==> acc(y.f)
    exhale !b ==> acc(x.f)
}
