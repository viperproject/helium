// Control for known_unsoundness/permissions/join_merge_nonaliasing_leak*.vpr: on
// the arm that holds 1/1 of `a.f` and 1/2 of `b.f`, `a != b` must still follow,
// after the inner join as before it.
field f: Int

method m(a: Ref, b: Ref, c: Bool, d: Bool)
  requires acc(a.f, 1/2) && acc(b.f, 1/2)
{
  if (d) {
    inhale acc(a.f, 1/2)
    if (c) {}
    assert a != b
  }
  assert d ==> a != b
}
