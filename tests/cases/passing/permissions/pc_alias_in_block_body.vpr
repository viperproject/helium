// A consume in a block body that draws on chunks aliased only under the block's
// cube (pc-alias): the permission and values left at the location afterwards, on
// the arm and off it. Companions of the `pc_alias_*` canaries in
// `tests/cases/failing/heap_fact_guard/`.
field f: Int

// The permission read back through the partner.
method perm_after_drain(x: Ref, y: Ref)
  requires acc(x.f, 1/2) && acc(y.f, 1/2)
{
  if (x == y) {
    exhale acc(y.f, 1/1)
    inhale acc(x.f, 1/1)
    assert perm(y.f) == write
  }
}

method perm_after_reinhale_through_partner(x: Ref, y: Ref, c: Bool)
  requires acc(x.f, 1/2) && acc(y.f, 1/2)
{
  if (c) {
    inhale x == y
    exhale acc(y.f, 1/1)
    inhale acc(y.f, 1/1)
    assert perm(x.f) == write
  }
}

// A partial drain leaves the other half at the location.
method partial_drain(x: Ref, y: Ref, c: Bool)
  requires acc(x.f, 1/2) && acc(y.f, 1/2)
{
  if (c) {
    inhale x == y
    exhale acc(y.f, 1/2)
    assert perm(x.f) == 1/2
    exhale acc(x.f, 1/2)
  }
}

// Exhale through the partner after the re-inhale.
method exhale_after_reinhale(x: Ref, y: Ref, c: Bool)
  requires acc(x.f, 1/2) && acc(y.f, 1/2)
{
  if (c) {
    inhale x == y
    exhale acc(y.f, 1/1)
    inhale acc(x.f, 1/1)
    exhale acc(y.f, 1/1)
  }
}

// The same without a branch: the alias is unconditional in the method body.
method unconditional_alias(x: Ref, y: Ref)
  requires acc(x.f, 1/2) && acc(y.f, 1/2)
{
  inhale x == y
  exhale acc(y.f, 1/1)
  inhale acc(x.f, 1/1)
  x.f := 3
  assert y.f == 3
}

// Off the arm nothing was given up: the sibling still holds both halves ...
method sibling_keeps_perm(x: Ref, y: Ref, c: Bool)
  requires acc(x.f, 1/2) && acc(y.f, 1/2)
{
  if (c) {
    inhale x == y
    exhale acc(y.f, 1/1)
  } else {
    exhale acc(x.f, 1/2) && acc(y.f, 1/2)
  }
}

// ... and so does a later block on the other path.
method after_join_keeps_perm_off_arm(x: Ref, y: Ref, c: Bool)
  requires acc(x.f, 1/2) && acc(y.f, 1/2)
{
  if (c) {
    inhale x == y
    exhale acc(y.f, 1/1)
  }
  if (!c) { exhale acc(x.f, 1/2) && acc(y.f, 1/2) }
}

// The re-inhaled value, after the join under the arm's condition.
method after_join_value(x: Ref, y: Ref, c: Bool)
  requires acc(x.f, 1/2) && acc(y.f, 1/2)
{
  if (c) {
    inhale x == y
    exhale acc(y.f, 1/1)
    inhale acc(x.f, 1/1) && x.f == 7
  }
  assert c ==> x.f == 7
}
