// Location axioms stated at a join are guarded by the join's reach condition,
// not dropped: wherever it holds they stay usable. Companions of the canaries
// in `tests/cases/failing/join_location_axioms/`.
field f: Int

method give(r: Ref)
  ensures acc(r.f)

// Inside the arm, after the inner join.
method after_inner_join(a: Ref, b: Ref, e: Bool, d: Bool)
  requires acc(a.f)
{
  if (e) {
    inhale acc(b.f)
    if (d) {
      inhale a.f == 1
    } else {
      inhale a.f == 2
    }
    assert a != b
  }
}

// After the outer join, as the implication it is.
method after_outer_join(a: Ref, b: Ref, e: Bool, d: Bool)
  requires acc(a.f)
{
  if (e) {
    give(b)
    if (d) {
      inhale a.f == 1
    } else {
      inhale a.f == 2
    }
  }
  assert e ==> a != b
}

// A top-level join has an empty reach condition: unconditional, as before.
method top_level_join(a: Ref, b: Ref, d: Bool)
  requires acc(a.f) && acc(b.f)
{
  if (d) {
    inhale a.f == 1
  } else {
    inhale a.f == 2
  }
  assert a != b
}

// Loop head inside an arm: the invariant's footprint is distinct after the loop.
method loop_head_in_arm(x: Ref, y: Ref, c: Bool, n: Int)
{
  var i: Int := 0
  if (c) {
    inhale acc(x.f) && acc(y.f)
    while (i < n)
      invariant acc(x.f) && acc(y.f)
    {
      i := i + 1
    }
    assert x != y
  }
}

// An arm over-full at an inner join is infeasible there.
method bound_at_inner_join(a: Ref, e: Bool, d: Bool)
  requires acc(a.f, 1/2)
{
  if (e) {
    inhale acc(a.f)
    if (d) {
      inhale a.f == 1
    } else {
      inhale a.f == 2
    }
    assert false
  }
}

// Nested loop heads inside an arm: distinct in both bodies, after the loops and,
// as an implication, after the arm.
method nested_loop_heads_in_arm(x: Ref, y: Ref, c: Bool, n: Int)
{
  if (c) {
    inhale acc(x.f) && acc(y.f)
    var i: Int := 0
    while (i < n) invariant acc(x.f) && acc(y.f) {
      var j: Int := 0
      while (j < n) invariant acc(x.f) && acc(y.f) {
        assert x != y
        j := j + 1
      }
      i := i + 1
    }
    assert x != y
  }
  assert c ==> x != y
}

// A loop in an arm of an outer loop's body, read in that arm.
method loop_head_in_arm_of_loop_body(x: Ref, y: Ref, c: Bool, n: Int)
{
  var i: Int := 0
  while (i < n) invariant true {
    if (c) {
      inhale acc(x.f) && acc(y.f)
      var j: Int := 0
      while (j < n) invariant acc(x.f) && acc(y.f) { j := j + 1 }
      assert x != y
    }
    i := i + 1
  }
}

// A loop left by a `goto` inside an arm, read at the label in the arm.
method loop_exit_goto_in_arm(x: Ref, y: Ref, c: Bool, n: Int)
{
  if (c) {
    inhale acc(x.f) && acc(y.f)
    var i: Int := 0
    while (i < n) invariant acc(x.f) && acc(y.f) {
      if (i == 3) { goto out }
      i := i + 1
    }
    label out
    assert x != y
  }
}

// A loop head reached on a disjunction of paths, read in its body and after it.
method loop_head_disjunctive_reach(x: Ref, y: Ref, c: Bool, d: Bool, e: Bool, n: Int)
{
  if (c) { if (d) { } else { goto E } } else { if (e) { } else { goto E } }
  inhale acc(x.f) && acc(y.f)
  var i: Int := 0
  while (i < n) invariant acc(x.f) && acc(y.f) { assert x != y; i := i + 1 }
  assert x != y
  label E
}

// The bound axiom of a loop head inside an arm, read in the arm.
method loop_head_bound_in_arm(x: Ref, p: Perm, c: Bool, n: Int)
  requires p >= none
{
  if (c) {
    inhale acc(x.f, p)
    while (n > 0) invariant acc(x.f, p) { }
    assert p <= write
  }
}

// A loop head after an inner join inside an arm, read in the arm.
method loop_head_after_inner_join_in_arm(x: Ref, y: Ref, c: Bool, d: Bool, n: Int)
{
  if (c) {
    inhale acc(x.f) && acc(y.f)
    if (d) { } else { }
    while (n > 0) invariant acc(x.f) && acc(y.f) { }
    assert x != y
  }
}

// A full and a half permission at a loop head inside an arm are distinct there.
method loop_head_full_and_half_in_arm(x: Ref, y: Ref, c: Bool, n: Int)
{
  if (c) {
    inhale acc(x.f) && acc(y.f, 1/2)
    while (n > 0) invariant acc(x.f) && acc(y.f, 1/2) { }
    assert x != y
  }
}
