// Location axioms stated at a join are guarded by the join's reach condition,
// not dropped: wherever it holds they stay usable. Companions of the canaries
// in `tests/cases/failing/join_location_axioms/`.
field f: Int

method give(r: Ref)
  ensures acc(r.f)

// Inside the arm, after the inner join.
method after_inner_join(a: Ref, b: Ref, e: Bool, d: Bool)
  requires acc(a.f)
{
  if (e) {
    inhale acc(b.f)
    if (d) {
      inhale a.f == 1
    } else {
      inhale a.f == 2
    }
    assert a != b
  }
}

// After the outer join, as the implication it is.
method after_outer_join(a: Ref, b: Ref, e: Bool, d: Bool)
  requires acc(a.f)
{
  if (e) {
    give(b)
    if (d) {
      inhale a.f == 1
    } else {
      inhale a.f == 2
    }
  }
  assert e ==> a != b
}

// A top-level join has an empty reach condition: unconditional, as before.
method top_level_join(a: Ref, b: Ref, d: Bool)
  requires acc(a.f) && acc(b.f)
{
  if (d) {
    inhale a.f == 1
  } else {
    inhale a.f == 2
  }
  assert a != b
}

// Loop head inside an arm: the invariant's footprint is distinct after the loop.
method loop_head_in_arm(x: Ref, y: Ref, c: Bool, n: Int)
{
  var i: Int := 0
  if (c) {
    inhale acc(x.f) && acc(y.f)
    while (i < n)
      invariant acc(x.f) && acc(y.f)
    {
      i := i + 1
    }
    assert x != y
  }
}

// An arm over-full at an inner join is infeasible there.
method bound_at_inner_join(a: Ref, e: Bool, d: Bool)
  requires acc(a.f, 1/2)
{
  if (e) {
    inhale acc(a.f)
    if (d) {
      inhale a.f == 1
    } else {
      inhale a.f == 2
    }
    assert false
  }
}
