// A consume in a block body that draws on chunks aliased only under the block's
// cube (pc-alias) leaves the cube out of its debit gate. Gated by it, a drained
// member was left at `held - (cube ? held : 0)`: zero wherever the block's heap
// exists, but not unconditionally, so it was never dropped, and what is
// re-inhaled, written and read afterwards at the location met a stale second
// chunk. Silicon verifies every method. Companions of
// `pc_alias_in_block_body.vpr`.
field f: Int

// Drain through `y`, re-inhale and write through `x`, read through `y`.
method drain_write_read(x: Ref, y: Ref, c: Bool)
  requires acc(x.f, 1/2) && acc(y.f, 1/2)
{
  if (c) {
    inhale x == y
    exhale acc(y.f, 1/1)
    inhale acc(x.f, 1/1)
    x.f := 3
    assert y.f == 3
  }
}

// ... with the alias as the branch condition itself (a cube literal).
method alias_is_the_cube(x: Ref, y: Ref)
  requires acc(x.f, 1/2) && acc(y.f, 1/2)
{
  if (x == y) {
    exhale acc(y.f, 1/1)
    inhale acc(x.f, 1/1)
    x.f := 3
    assert y.f == 3
  }
}

// Drain through `x` itself, the value coming from the re-inhale.
method drain_inhale_value(x: Ref, y: Ref, c: Bool)
  requires acc(x.f, 1/2) && acc(y.f, 1/2)
{
  if (c) {
    inhale x == y
    exhale acc(x.f, 1/1)
    inhale acc(x.f, 1/1) && x.f == 3
    assert y.f == 3
  }
}

// Drain in two exhales of a half each, over two partners, then re-inhale, write
// and read.
method drain_in_halves(x: Ref, y0: Ref, y1: Ref)
  requires acc(y0.f, 1/2) && acc(y1.f, 1/2)
{
  if (x == y0 && x == y1) {
    exhale acc(x.f, 1/2)
    exhale acc(x.f, 1/2)
    inhale acc(x.f, 1/1)
    x.f := 3
    assert y0.f == 3
  }
}
