// Type ascriptions naming the domain's own type parameters, as Gobra writes
// them (`(tuple2(t0, t1): Tuple2[T0, T1])`): the `T0` in an ascription is the
// domain's `T0`, not a type of the same name.
domain Tuple2[T0, T1] {
  function get0of2(p: Tuple2[T0, T1]): T0
  function get1of2(p: Tuple2[T0, T1]): T1
  function tuple2(t0: T0, t1: T1): Tuple2[T0, T1]

  axiom getter_over_tuple2 {
    (forall t0: T0, t1: T1 ::
      { (tuple2(t0, t1): Tuple2[T0, T1]) }
      (get0of2((tuple2(t0, t1): Tuple2[T0, T1])): T0) == t0 &&
      (get1of2((tuple2(t0, t1): Tuple2[T0, T1])): T1) == t1)
  }
}

method m(x: Int, b: Bool) {
  var p: Tuple2[Int, Bool] := tuple2(x, b)
  assert get0of2(p) == x
  assert (get1of2(p): Bool) == b
}
