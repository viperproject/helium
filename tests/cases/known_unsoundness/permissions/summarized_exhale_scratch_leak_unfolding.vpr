// The scratch leak of summarized_exhale_scratch_leak_predicate.vpr through an
// `unfolding` expression, whose temporary consume of `P(x)` goes down the same
// summarized path.

field f: Int

predicate P(r: Ref) { acc(r.f) }

method m(c: Bool, a: Ref, b: Ref) returns (r: Int)
  requires P(a) && P(b) && (unfolding P(a) in a.f) == 1 && (unfolding P(b) in b.f) == 2
{
  var x: Ref
  if (c) { x := a } else { x := b }
  r := unfolding P(x) in x.f
  assert false
}
