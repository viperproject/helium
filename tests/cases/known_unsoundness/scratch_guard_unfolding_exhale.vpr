// REGRESSION (soundness). `scratch_guard_unfolding_ternary.vpr` with the
// `unfolding` under an implication in an exhale.
// The `exhale c ==> acc(x.f)` before it is a pc-alias consume, which warms the
// block scratch.
//
// Must FAIL.
field f: Int
predicate Q(r: Ref, v: Int) { acc(r.f) && v == 5 }

method scratch_guard_unfolding_exhale(x: Ref, y: Ref, v: Int, b: Bool, c: Bool)
  requires acc(x.f, 1/2) && acc(y.f, 1/2) && (c ==> x == y)
  requires b ==> Q(y, v)
{
  exhale c ==> acc(x.f)
  exhale b ==> (unfolding Q(y, v) in true)
  assert v == 5
}
