// REGRESSION (soundness). An `unfolding` in the else arm of a ternary: the guard
// is the negated condition, a negative intra-block literal.
// The leading `exhale c ==> acc(x.f)` is a pc-alias consume, which warms the block
// scratch.
//
// Must FAIL.
field f: Int
predicate Q(r: Ref, v: Int) { acc(r.f) && v == 5 }

method scratch_guard_unfolding_else_arm(x: Ref, y: Ref, v: Int, b: Bool, c: Bool)
  requires acc(x.f, 1/2) && acc(y.f, 1/2) && (c ==> x == y)
  requires !b ==> Q(y, v)
{ exhale c ==> acc(x.f)
  var t: Int := b ? 0 : (unfolding Q(y, v) in 1)
  assert v == 5 }
