// dead_exit_union.vpr with a live normal exit: neither exit can prove the frame
// residual `1 - q` positive, so nothing equates the frame's value with the
// head's havoc.
//
// Must FAIL. Silicon: "Assertion x.f == 3 might not hold."
field f: Int

method m(x: Ref, q: Perm, b: Bool, c: Bool)
  requires none < q && q <= write && acc(x.f)
{
  x.f := 3
  while (c)
    invariant acc(x.f, q)
  {
    if (b) { goto out }
  }
  label out
  assert x.f == 3
}
