// `loop_head_in_arm.vpr`, read on the sibling arm: the then arm's loop head must
// not tell the else arm that `x != y`. Silicon rejects.
field f: Int

method loop_head_to_sibling(x: Ref, y: Ref, c: Bool, n: Int)
{
  var i: Int := 0
  if (c) {
    inhale acc(x.f) && acc(y.f)
    while (i < n)
      invariant acc(x.f) && acc(y.f)
    {
      i := i + 1
    }
  } else {
    assert x != y
  }
}
