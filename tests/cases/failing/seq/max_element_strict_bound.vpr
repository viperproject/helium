// Seq (verification-heavy): the maximum is itself an element, so it cannot be
// STRICTLY greater than every element.

method max_element(s: Seq[Int]) returns (m: Int)
  requires |s| > 0
  ensures forall i: Int :: { s[i] } 0 <= i && i < |s| ==> s[i] < m
{
  m := s[0]
  var i: Int := 1
  while (i < |s|)
    invariant 1 <= i && i <= |s|
    invariant forall j: Int :: { s[j] } 0 <= j && j < i ==> s[j] <= m
  {
    if (s[i] > m) {
      m := s[i]
    }
    i := i + 1
  }
}
