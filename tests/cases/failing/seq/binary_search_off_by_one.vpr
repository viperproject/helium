// Seq (verification-heavy): binary search with the classic off-by-one bug.
// `high` is exclusive, so `high := mid - 1` also discards `xs[mid - 1]`, which
// may be the key (xs = [1, 2, 3], key = 1: mid = 1, high := 0, key lost). The
// "key is not outside [low, high)" invariant must fail to be preserved.

method binary_search(xs: Seq[Int], key: Int) returns (index: Int)
  requires forall i: Int, j: Int :: { xs[i], xs[j] } 0 <= i && j < |xs| && i < j ==> xs[i] < xs[j]
  ensures -1 <= index && index < |xs|
  ensures 0 <= index ==> xs[index] == key
  ensures index == -1 ==> forall i: Int :: { xs[i] } 0 <= i && i < |xs| ==> xs[i] != key
{
  var low: Int := 0
  var high: Int := |xs|
  index := -1

  while (low < high && index == -1)
    invariant 0 <= low && low <= high + 1 && high <= |xs|
    invariant -1 <= index && index < |xs|
    invariant 0 <= index ==> xs[index] == key
    invariant index == -1 ==>
      forall i: Int :: { xs[i] } 0 <= i && i < |xs| && !(low <= i && i < high) ==> xs[i] != key
  {
    var mid: Int := (low + high) \ 2
    if (xs[mid] < key) {
      low := mid + 1
    } else {
      if (key < xs[mid]) {
        high := mid - 1
      } else {
        index := mid
      }
    }
  }
}
