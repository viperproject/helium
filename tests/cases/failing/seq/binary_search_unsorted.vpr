// Seq (verification-heavy): binary search WITHOUT the sortedness precondition.
// Discarding half the window is then unjustified (xs = [3, 1, 2], key = 1:
// mid = 1 finds it, but key = 3: xs[1] = 1 < 3 so low := 2 and xs[0] is lost),
// so preserving the "not outside [low, high)" invariant must fail.

method binary_search(xs: Seq[Int], key: Int) returns (index: Int)
  ensures -1 <= index && index < |xs|
  ensures 0 <= index ==> xs[index] == key
  ensures index == -1 ==> forall i: Int :: { xs[i] } 0 <= i && i < |xs| ==> xs[i] != key
{
  var low: Int := 0
  var high: Int := |xs|
  index := -1

  while (low < high && index == -1)
    invariant 0 <= low && low <= high && high <= |xs|
    invariant -1 <= index && index < |xs|
    invariant 0 <= index ==> xs[index] == key
    invariant index == -1 ==>
      forall i: Int :: { xs[i] } 0 <= i && i < |xs| && !(low <= i && i < high) ==> xs[i] != key
  {
    var mid: Int := (low + high) \ 2
    if (xs[mid] < key) {
      low := mid + 1
    } else {
      if (key < xs[mid]) {
        high := mid
      } else {
        index := mid
      }
    }
  }
}
