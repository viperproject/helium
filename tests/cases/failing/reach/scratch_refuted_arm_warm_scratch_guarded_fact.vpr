// SOUNDNESS CANARY for tagging a block dead when its scratch refutes its cube:
// the scratch may hold only what ground implies under the cube.
//
// The pc-alias consume `exhale c ==> acc(x.f)` builds the `d` arm's scratch
// early. The `inhale b ==> (unfolding ..)` after it assumes `v == 5` under the
// intra-block literal `b`, so with `v != 5` the arm is live exactly where `!b`.
// A scratch that took `v == 5` unguarded would be inconsistent, the arm would
// be tagged dead, the join would drop the heap that lacks `acc(z.f)`, and the
// write would verify.
field f: Int
predicate Q(r: Ref, v: Int) { acc(r.f) && v == 5 }

method m(x: Ref, y: Ref, z: Ref, v: Int, b: Bool, c: Bool, d: Bool)
  requires acc(x.f, 1/2) && acc(y.f, 1/2) && (c ==> x == y)
  requires b ==> Q(y, v)
  requires acc(z.f)
{
  if (d) {
    exhale c ==> acc(x.f)
    inhale b ==> (unfolding Q(y, v) in true)
    inhale v != 5
    exhale acc(z.f)
  }
  z.f := 1
}
