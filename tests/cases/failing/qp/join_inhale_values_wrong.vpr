// QP medium (branch join): both paths inhale the chunk set with fresh maps and
// different values. Catches a join that unifies the two fresh maps instead of
// selecting between them.
//
// Must FAIL (assertion).
field f: Int

method join_inhale_values_wrong(s: Set[Ref], a: Ref, c: Bool)
  requires a in s
{
  if (c) {
    inhale forall x: Ref :: x in s ==> acc(x.f)
    inhale a.f == 1
  } else {
    inhale forall x: Ref :: x in s ==> acc(x.f)
    inhale a.f == 2
  }
  assert a.f == 1
}
