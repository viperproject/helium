// A quantified precondition is not framed by a set that was exhaled.
//
// Must FAIL (insufficient permission).
field f: Int

function get(s: Set[Ref], a: Ref): Int
  requires forall x: Ref :: x in s ==> acc(x.f, wildcard)
  requires a in s
{
  a.f
}

method wildcard_function_pre_exhaled(s: Set[Ref], a: Ref)
  requires forall x: Ref :: x in s ==> acc(x.f)
  requires a in s
{
  exhale forall x: Ref :: x in s ==> acc(x.f)
  var v: Int := get(s, a)
}
