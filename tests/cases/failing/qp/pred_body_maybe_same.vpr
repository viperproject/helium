// A QP over a two-argument predicate with a body: `P(a, b)` and `P(a, c)` may
// be the same instance, since `b` and `c` may be equal.
//
// Must FAIL (insufficient permission).
field f: Int
field g: Int

// Owns the first argument's `f` and the second argument's `g`.
predicate P(x: Ref, y: Ref) {
  acc(x.f) && acc(y.g)
}

method pred_body_maybe_same(s: Set[Ref], t: Set[Ref], a: Ref, b: Ref, c: Ref)
  requires a in s && b in t && c in t
{
  inhale forall x: Ref, y: Ref :: x in s && y in t ==> acc(P(x, y))
  exhale acc(P(a, b))
  exhale acc(P(a, c))
}
