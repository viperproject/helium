// QP medium: like `frame_other_member`, but `a != b` is missing, so the write
// may have changed `b.f`.
//
// Must FAIL (assertion).
field f: Int

method frame_includes_written(s: Set[Ref], a: Ref, b: Ref)
  requires forall x: Ref :: x in s ==> acc(x.f)
  requires a in s && b in s
{
  var v: Int := b.f
  a.f := v + 1
  assert b.f == v
}
