// QP injectivity over a two-argument predicate with a body: the binder `y` is
// not an argument, so `P(x, r)` is named once for every `y` in `t`.
//
// Must FAIL (quantified permission might not be injective).
field f: Int
field g: Int

// Owns the first argument's `f` and the second argument's `g`.
predicate P(x: Ref, y: Ref) {
  acc(x.f) && acc(y.g)
}

method pred_body_binder_unused(s: Set[Ref], t: Set[Ref], r: Ref)
{
  inhale forall x: Ref, y: Ref :: x in s && y in t ==> acc(P(x, r))
}
