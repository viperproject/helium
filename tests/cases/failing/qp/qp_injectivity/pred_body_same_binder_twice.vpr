// QP injectivity over a two-argument predicate with a body: both arguments are
// `x`, so the binder `y` does not determine the instance.
//
// Must FAIL (quantified permission might not be injective).
field f: Int
field g: Int

// Owns the first argument's `f` and the second argument's `g`.
predicate P(x: Ref, y: Ref) {
  acc(x.f) && acc(y.g)
}

method pred_body_same_binder_twice(s: Set[Ref], t: Set[Ref])
{
  inhale forall x: Ref, y: Ref :: x in s && y in t ==> acc(P(x, x))
}
