// QP medium (branch join): the branches hold chunk sets over different
// domains, and `a` is only known to be in one of them.
//
// Must FAIL (insufficient permission).
field f: Int

method join_different_sets_not_member(s: Set[Ref], t: Set[Ref], a: Ref, c: Bool)
  requires a in s
{
  if (c) {
    inhale forall x: Ref :: x in s ==> acc(x.f)
  } else {
    inhale forall x: Ref :: x in t ==> acc(x.f)
  }
  a.f := 1
}
