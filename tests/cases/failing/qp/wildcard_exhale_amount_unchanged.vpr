// A wildcard exhale takes a positive amount: the amount held changes.
//
// Must FAIL (assertion).
field f: Int

method wildcard_exhale_amount_unchanged(s: Set[Ref], a: Ref)
  requires forall x: Ref :: x in s ==> acc(x.f)
  requires a in s
{
  exhale forall x: Ref :: x in s ==> acc(x.f, wildcard)
  assert perm(a.f) == write
}
