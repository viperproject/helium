// A QP over a two-argument predicate with a body: one instance cannot be
// exhaled twice.
//
// Must FAIL (insufficient permission).
field f: Int
field g: Int

// Owns the first argument's `f` and the second argument's `g`.
predicate P(x: Ref, y: Ref) {
  acc(x.f) && acc(y.g)
}

method pred_body_exhale_twice(s: Set[Ref], t: Set[Ref], a: Ref, b: Ref)
  requires a in s && b in t
{
  inhale forall x: Ref, y: Ref :: x in s && y in t ==> acc(P(x, y))
  exhale acc(P(a, b))
  exhale acc(P(a, b))
}
