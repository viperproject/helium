// QP easy: the second exhale of the same chunk set finds nothing left. Its
// containment proof needs 1 <= 1 - 1.
//
// Must FAIL (insufficient permission).
field f: Int

method inhale_exhale_twice(s: Set[Ref])
{
  inhale forall x: Ref :: x in s ==> acc(x.f)
  exhale forall x: Ref :: x in s ==> acc(x.f)
  exhale forall x: Ref :: x in s ==> acc(x.f)
}
