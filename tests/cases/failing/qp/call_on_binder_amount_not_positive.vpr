// A call on the binder in a quantified permission's amount: where the value
// may not be positive, the inhaled half may be none.
//
// Must FAIL (insufficient permission).
field val: Int
function get(x: Ref): Int
  requires acc(x.val, wildcard)
{ x.val }

method amount(s: Set[Ref], a: Ref)
  requires forall x: Ref :: x in s ==> acc(x.val, 1/2)
  requires a in s
{
  inhale forall x: Ref :: x in s ==> acc(x.val, get(x) > 0 ? 1/2 : none)
  a.val := 3
}
