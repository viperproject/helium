// QP easy: after exhaling the whole chunk set, no permission is left to read a
// member of it.
//
// Must FAIL (insufficient permission).
field f: Int

method inhale_exhale_then_read(s: Set[Ref], a: Ref)
{
  inhale forall x: Ref :: x in s ==> acc(x.f)
  inhale a in s
  exhale forall x: Ref :: x in s ==> acc(x.f)
  var v: Int := a.f
}
