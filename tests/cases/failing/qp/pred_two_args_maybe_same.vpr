// A QP over a two-argument predicate: `P(a, b)` and `P(a, c)` may be the same
// instance, since `b` and `c` may be equal.
//
// Must FAIL (insufficient permission).
predicate P(x: Ref, y: Ref)

method pred_two_args_maybe_same(s: Set[Ref], t: Set[Ref], a: Ref, b: Ref, c: Ref)
  requires a in s && b in t && c in t
{
  inhale forall x: Ref, y: Ref :: x in s && y in t ==> acc(P(x, y))
  exhale acc(P(a, b))
  exhale acc(P(a, c))
}
