// QP hard: the postcondition claims the whole array is zero, but the loop
// invariant only tracks the prefix below `k - 1`, so the last element written
// is forgotten.
//
// Must FAIL (postcondition).
field val: Int

domain IArray {
  function slot(a: IArray, i: Int): Ref
  function len(a: IArray): Int
  function first(r: Ref): IArray
  function second(r: Ref): Int

  axiom slot_injective {
    forall a: IArray, i: Int :: { slot(a, i) } first(slot(a, i)) == a && second(slot(a, i)) == i
  }
  axiom len_nonneg {
    forall a: IArray :: { len(a) } len(a) >= 0
  }
}

method zero(a: IArray)
  requires forall i: Int :: 0 <= i && i < len(a) ==> acc(slot(a, i).val)
  ensures forall i: Int :: 0 <= i && i < len(a) ==> acc(slot(a, i).val)
  ensures forall i: Int :: { slot(a, i).val } 0 <= i && i < len(a) ==> slot(a, i).val == 0
{
  var k: Int := 0
  while (k < len(a))
    invariant 0 <= k && k <= len(a)
    invariant forall i: Int :: 0 <= i && i < len(a) ==> acc(slot(a, i).val)
    invariant forall i: Int :: { slot(a, i).val } 0 <= i && i < k - 1 ==> slot(a, i).val == 0
  {
    slot(a, k).val := 0
    k := k + 1
  }
}
