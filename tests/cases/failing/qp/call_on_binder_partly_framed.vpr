// A call on the binder framed for the members of `s`, but not for `a`.
//
// Must FAIL (insufficient permission).
field val: Int
function get(x: Ref): Int
  requires acc(x.val, wildcard)
{ x.val }

method m(s: Set[Ref], a: Ref)
  requires forall x: Ref :: x in s ==> acc(x.val)
{
  inhale forall x: Ref :: { get(x) } x in s || x == a ==> get(x) == 0
}
