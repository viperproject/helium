// After a wildcard exhale less than write permission remains.
//
// Must FAIL (insufficient permission).
field f: Int

method wildcard_exhale_write(s: Set[Ref], a: Ref)
  requires forall x: Ref :: x in s ==> acc(x.f)
  requires a in s
{
  exhale forall x: Ref :: x in s ==> acc(x.f, wildcard)
  a.f := 1
}
