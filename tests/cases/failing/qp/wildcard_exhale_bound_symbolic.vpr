// `wildcard_exhale_bound_sibling` with a symbolic amount: the take under
// `none < p` must not make `p == none` unreachable.
//
// Must FAIL (assertion).
field f: Int

method wildcard_exhale_bound_symbolic(s: Set[Ref], a: Ref, p: Perm) {
  inhale none <= p && p <= 1/2
  inhale forall x: Ref :: { x.f } x in s ==> acc(x.f, p)
  inhale forall x: Ref :: { x.f } x in s ==> acc(x.f, wildcard)
  inhale a in s
  if (none < p) {
    exhale forall x: Ref :: { x.f } x in s ==> acc(x.f, wildcard)
    var v: Int := a.f
  }
  if (p == none) { assert false }
}
