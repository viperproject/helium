// After a wildcard exhale the full permission is no longer held.
//
// Must FAIL (insufficient permission).
field f: Int

method wildcard_exhale_then_full(s: Set[Ref], a: Ref)
  requires forall x: Ref :: x in s ==> acc(x.f)
  requires a in s
{
  exhale forall x: Ref :: x in s ==> acc(x.f, wildcard)
  exhale acc(a.f)
}
