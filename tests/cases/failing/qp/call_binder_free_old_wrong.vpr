// A binder-free heap-dependent call under `old` inside a `forall` reads the
// pre-state: after the callee changes `y.val`, the old value is not the new.
//
// Must FAIL (postcondition).
field val: Int

function get(x: Ref): Int
  requires acc(x.val, wildcard)
{ x.val }

domain D { function t(i: Int): Bool }

method bump(y: Ref)
  requires acc(y.val)
  ensures acc(y.val)
  ensures forall i: Int :: { t(i) } t(i) ==> old(get(y)) == get(y)
{
  y.val := y.val + 1
}
