// A label inside a (goto) loop body, read earlier in the body: within an
// iteration the read precedes the label, and the loop body is verified from an
// arbitrary iteration, so an earlier iteration's label state is not available.
field f: Int

method m(x: Ref, n: Int)
  requires acc(x.f) && n >= 0
{
  var i: Int := 0
  label head
    invariant acc(x.f) && 0 <= i && i <= n
  if (i >= n) {
    goto out
  }
  assert i > 0 ==> old[body](x.f) == old[body](x.f)
  label body
  x.f := x.f + 1
  i := i + 1
  goto head
  label out
}
