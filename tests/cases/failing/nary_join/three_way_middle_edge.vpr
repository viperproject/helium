// REGRESSION (soundness). A label reached by three or more edges is lowered as a
// chain of binary merges. An inner level merges edges `i..` only, and its edge
// value is simplified against that reach, here `!a`, to just `b`. Its merge was
// placed under the whole join's reach, so the inhaled heap's `x != y` held under
// `b` alone, also on `a && b`, where nothing was inhaled and `x == y` is
// consistent.
//
// Must FAIL.
field f: Int

method m(x: Ref, y: Ref, a: Bool, b: Bool)
{
  if (a) { goto L }
  if (b) { inhale acc(x.f) && acc(y.f); goto L }
  label L
  assert b ==> x != y
}
