// Soundness canary for `passing/ctor_ite_unreachable_bottom_arm.vpr`: only the
// path to the unreachable call is refuted. The sibling arm `other(d)` stays
// reachable (at `d == 0`), so the top arm's guard stays open.

adt E { c0() c1(x: Int) c2() }

function unreachable(): E
  ensures false

function other(d: Int): E

function tower(d: Int): E
{
  d == 2 ? c2() : (d == 1 ? unreachable() : other(d))
}

method top_arm_not_pinned(d: Int)
{
  assume tower(d) == c2()
  assert d == 2
}
