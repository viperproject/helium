// A write through a location whose permission is spread over two chunks that
// coincide only inside the branch. After the join, on the path where `x` differs
// from `y1`, `y1.f` was never written.

field f: Int

method m(x: Ref, y0: Ref, y1: Ref)
  requires acc(y0.f, 1/2) && acc(y1.f, 1/2)
{
  if (x == y0 && x == y1) {
    x.f := 5
  }
  assert y1.f == 5
}
