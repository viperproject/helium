// Three chunks are one location inside the branch, holding `1/1` together; the
// exhales take `1/2 + 1/2 + 1/10`.

field f: Int

method m(x: Ref, y0: Ref, y1: Ref, y2: Ref)
  requires acc(y0.f, 1/3) && acc(y1.f, 1/3) && acc(y2.f, 1/3)
{
  if (x == y0 && x == y1 && x == y2) {
    exhale acc(x.f, 1/2)
    exhale acc(x.f, 1/2)
    exhale acc(x.f, 1/10)
  }
}
