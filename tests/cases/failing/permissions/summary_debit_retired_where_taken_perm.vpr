// Variant of summary_debit_retired_where_taken.vpr observed through `perm`: on `!b`
// the summarized consume of `acc(r.f)` drained `y.f`, so `perm(y.f) == write` must
// not be provable.

field f: Int

method m(x: Ref, y: Ref, b: Bool)
    requires acc(x.f) && acc(y.f)
{
    var r: Ref
    if (b) { r := x } else { r := y }
    exhale acc(r.f)
    assert perm(y.f) == write
}
