// Variant of summary_debit_retired_under_guard.vpr: on `!b` the summarized consume
// of `acc(r.f)` drained `x.f`, so not even a fraction of it is left there.

field f: Int

method m(x: Ref, b: Bool)
    requires acc(x.f)
{
    var r: Ref
    if (b) { r := new(f) } else { r := x }
    exhale acc(x.f)
    inhale acc(x.f)
    exhale acc(r.f)
    exhale !b ==> acc(x.f, 1/100)
}
