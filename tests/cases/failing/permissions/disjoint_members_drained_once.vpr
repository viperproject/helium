// Each arm allocates its own location, so after the join `r.f` is held by one of two
// chunks under complementary guards. One consume of `r.f` takes the whole location on
// either path; a second must be rejected.

field f: Int

method m(b: Bool)
{
    var r: Ref
    if (b) {
        r := new(f)
    } else {
        r := new(f)
    }
    exhale acc(r.f)
    exhale acc(r.f)
}
