// As `scaled_gated_slot_off.vpr`, through a call's precondition. Silicon rejects it.

field f: Int

predicate PG(x: Ref, b: Bool) { b ==> acc(x.f, 1/2) }

function rd(x: Ref): Int
    requires acc(x.f, write)
{ x.f }

function bad(x: Ref, b: Bool): Int
    requires acc(PG(x, b), write)
{ unfolding acc(PG(x, b), write) in rd(x) }
