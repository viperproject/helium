// NOTE: today this is rejected for the wrong reason (typecheck refuses
// `old[L]` on a label inside a loop body). Once that is supported, it must
// still be rejected by the verifier itself.

// The `goto Skip` path bypasses the increment, so `+1` does not hold at the
// join on every path. Must FAIL.
field f: Int

method goto_skip_path_unwritten(x: Ref, n: Int, b: Bool)
  requires acc(x.f)
  ensures acc(x.f)
{
  var i: Int := 0
  while (i < n)
    invariant acc(x.f)
  {
    label Top
    if (b) { goto Skip }
    x.f := x.f + 1
    label Skip
    assert x.f == old[Top](x.f) + 1
    i := i + 1
  }
}
