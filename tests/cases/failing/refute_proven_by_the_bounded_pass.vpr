// A `refute` whose expression is proven fails, however many instances the
// pass that proved it deferred: knowing more cannot unprove it. Proven here by
// the generation-bounded first pass, where `grow` (a cubic matching loop) ends
// at a fixpoint; without the bound it reaches the growth limit before the
// 90-deep unfolding of `c90` finishes, and the proof would fail.
domain Cube {
  function a(i: Int): Bool
  function b(i: Int): Bool
  function c(i: Int): Bool
  function h(i: Int, j: Int, k: Int): Bool
  axiom grow { forall i: Int, j: Int, k: Int :: { a(i), b(j), c(k) } a(i + 1) && b(j + 1) && c(k + 1) && h(i, j, k) }
}
function c0(x: Int): Int { x }
function c1(x: Int): Int { c0(x) }
function c2(x: Int): Int { c1(x) }
