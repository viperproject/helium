// REGRESSION (soundness). An `unfolding` under two nested ternary conditions: both
// are intra-block literals and both must stay in the scratch's fact.
// The leading `exhale c ==> acc(x.f)` is a pc-alias consume, which warms the block
// scratch.
//
// Must FAIL.
field f: Int
predicate Q(r: Ref, v: Int) { acc(r.f) && v == 5 }

method scratch_guard_unfolding_nested_ternary(x: Ref, y: Ref, v: Int, b: Bool, c: Bool, d: Bool)
  requires acc(x.f, 1/2) && acc(y.f, 1/2) && (c ==> x == y)
  requires (b && d) ==> Q(y, v)
{ exhale c ==> acc(x.f)
  var t: Int := b ? (d ? (unfolding Q(y, v) in 1) : 0) : 0
  assert d ==> v == 5 }
