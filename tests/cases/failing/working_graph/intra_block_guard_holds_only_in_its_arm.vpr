// A fact inhaled under an intra-block condition (`c ==> x == 1`, inside the `d`
// arm) holds in a nested `c` arm and not in the nested `!c` arm. The first `if`
// builds the working graph before the branch.
//
// Must FAIL (the assert in the `!c` arm).

domain D { function f(x: Int): Int }

method i2(x: Int, z: Int, c: Bool, d: Bool)
{
  if (x == z) { assert f(x) == f(z) }
  if (d) {
    inhale c ==> x == 1
    assert c ==> f(x) == f(1)
    if (c) { assert x == 1 } else { assert x == 1 }
  }
}
