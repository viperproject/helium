// A block reached by `goto` from both arms (`Q`), walked after them, sees
// neither arm's fact unguarded: the else-arm reaches it without `x == 1`. The
// first `if` builds the working graph before the branch.
//
// Must FAIL (the assert at `Q`).

domain D { function f(x: Int): Int }

method g3(x: Int, z: Int, c: Bool, d: Bool)
{
  if (x == z) { assert f(x) == f(z) }
  if (c) {
    inhale x == 1
    assert f(x) == f(1)
    goto Q
  } else {
    if (d) { goto Q }
    inhale x == 2
  }
  goto E
  label Q
  assert x == 1
  label E
}
