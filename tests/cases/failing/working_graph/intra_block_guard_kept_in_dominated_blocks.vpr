// A fact inhaled under an intra-block condition (`c ==> x == 1`) keeps that
// condition as a guard in the blocks the current one dominates, here past a
// later branch and its join. The first `if` builds the working graph before the
// branch.
//
// Must FAIL (the last assert).

domain D { function f(x: Int): Int }

method i1(x: Int, z: Int, c: Bool, d: Bool)
{
  if (x == z) { assert f(x) == f(z) }
  inhale c ==> x == 1
  assert f(x) == f(x)
  if (d) { assert f(1) == f(1) } else { assert f(2) == f(2) }
  assert x == 1
}
