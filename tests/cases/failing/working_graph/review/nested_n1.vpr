// From the PR 4 review (nested.vpr, `n1`): must FAIL.

domain D { function f(x: Int): Int }

// deep else-chain: inner arm facts must not reach outer sibling arms
method n1(x: Int, z: Int, a: Int)
{
  if (x == z) { assert f(x) == f(z) }
  if (a == 0) { inhale x == 0; assert f(x) == f(0) }
  elseif (a == 1) { inhale x == 1; assert f(x) == f(1) }
  elseif (a == 2) { inhale x == 2; assert f(x) == f(2) }
  else { assert x == 0 || x == 1 || x == 2 }
}
