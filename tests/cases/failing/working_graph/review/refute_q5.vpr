// From the PR 4 review (refute.vpr, `q5`): must FAIL.

domain D { function f(x: Int): Int }
function g(x: Int): Int requires x > 0 { x + 1 }

method q5(x: Int, z: Int, c: Bool)
{
  if (x == z) { assert f(x) == f(z) }
  if (c) {
    inhale forall i: Int :: { f(i) } f(i) > 0
    if (x > 0) { assert f(x) > 0 } else { assert f(z) > 0 }
    refute f(x + 7) > 0
  }
}
