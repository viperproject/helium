// From the PR 4 review (pcalias.vpr, `p6`): must FAIL.

domain D { function f(x: Int): Int }
field v: Int

method p6(a: Ref, b: Ref, c: Bool, x: Int, z: Int)
  requires acc(a.v, 1/2) && acc(b.v, 1/2) && (c ==> a == b)
{
  if (x == z) { assert f(x) == f(z) }
  exhale c ==> acc(b.v, 1/1)
  assert c
}
