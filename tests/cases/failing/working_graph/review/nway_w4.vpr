// From the PR 4 review (nway.vpr, `w4`): must FAIL.

domain D { function f(x: Int): Int }
field v: Int

// loop with goto exit
method w4(x: Int, z: Int, n: Int)
{
  var i: Int := 0
  if (x == z) { assert f(x) == f(z) }
  while (i < n) invariant 0 <= i
  {
    if (i == 5) { inhale x == 9; assert f(x) == f(9); goto Out }
    i := i + 1
  }
  label Out
  assert x == 9
}
