// From the PR 4 review (refute.vpr, `q2`): must FAIL.

domain D { function f(x: Int): Int }
function g(x: Int): Int requires x > 0 { x + 1 }

method q2(x: Int, z: Int, c: Bool, d: Bool)
{
  if (x == z) { assert f(x) == f(z) }
  if (c) { inhale x == 1; assert f(x) == f(1) }
  if (d) { refute c ==> x == 1 }
}
