// From the PR 4 review (nway.vpr, `w2`): must FAIL.

domain D { function f(x: Int): Int }
field v: Int

// panic block reached from two arms of different diamonds, emitted at the end
method w2(x: Int, z: Int, c: Bool, d: Bool)
{
  if (x == z) { assert f(x) == f(z) }
  if (c) { inhale x == 1; assert f(x) == f(1); if (d) { goto P } }
  if (!c) { inhale x == 2; assert f(x) == f(2); if (d) { goto P } }
  assert x == 1 || x == 2
  goto E
  label P
  assert d
  assert x == 1
  label E
}
