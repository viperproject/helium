// From the PR 4 review (intra1.vpr, `i2`): must FAIL.

domain D { function f(x: Int): Int }

method i2(x: Int, z: Int, c: Bool, d: Bool)
{
  if (x == z) { assert f(x) == f(z) }
  if (d) {
    inhale c ==> x == 1
    assert c ==> f(x) == f(1)
    if (c) { assert x == 1 } else { assert x == 1 }
  }
}
