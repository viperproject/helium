// A quantifier inhaled in a nested arm is available after the nested join under
// its arm's condition (the second assert verifies), and not in the outer
// sibling arm. The first `if` builds the working graph before the branch.
//
// Must FAIL (the assert in the outer else-arm).

domain D { function f(x: Int): Int }

method r4(x: Int, z: Int, c: Bool, d: Bool)
{
  if (x == z) { assert f(x) == f(z) }
  if (c) {
    if (d) {
      inhale forall i: Int :: { f(i) } f(i) > 0
      assert f(x) > 0
    } else {
      assert f(z) == f(z)
    }
    assert d ==> f(x + 1) > 0
  } else {
    assert f(x) > 0
  }
}
