// Both arms establish `x == 1`, so it holds after the join and the `refute`
// fails. The Z3 rung proves it from both arms; Silicon rejects the method
// too. The first `if` builds the working graph before the branch.
//
// Must FAIL (the `refute`).

domain D { function f(x: Int): Int }

method q1(x: Int, z: Int, c: Bool)
{
  if (x == z) { assert f(x) == f(z) }
  if (c) { inhale x == 1; assert f(x) == f(1) } else { inhale x == 1 }
  refute x == 1
}
