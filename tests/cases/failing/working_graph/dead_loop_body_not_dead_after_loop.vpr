// A dead loop body (`inhale false`) does not make the code after the loop dead.
// The first `if` builds the working graph before the branch.
//
// Must FAIL (`assert false` after the loop).

domain D { function f(x: Int): Int }

method l3(x: Int, z: Int, n: Int)
{
  var i: Int := 0
  if (x == z) { assert f(x) == f(z) }
  while (i < n) invariant 0 <= i
  {
    inhale false
  }
  assert false
}
