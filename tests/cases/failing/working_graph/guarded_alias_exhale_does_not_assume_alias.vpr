// An exhale guarded by an alias (`c ==> (a == b ==> acc(b.v, 1/1))`) does not
// assume the alias. The first `if` builds the working graph before the branch.
//
// Must FAIL (the assert after the exhale).

domain D { function f(x: Int): Int }
field v: Int

method p5(a: Ref, b: Ref, c: Bool, x: Int, z: Int)
  requires acc(a.v, 1/2) && acc(b.v, 1/2)
{
  if (x == z) { assert f(x) == f(z) }
  exhale c ==> (a == b ==> acc(b.v, 1/1))
  assert a == b
}
