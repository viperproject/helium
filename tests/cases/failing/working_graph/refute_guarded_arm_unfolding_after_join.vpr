// A function unfolding proven in an arm holds after the join guarded by the
// arm's condition, so a `refute` of the guarded unfolding fails. The first `if`
// builds the working graph before the branch.
//
// Must FAIL (the `refute`).

domain D { function f(x: Int): Int }
function g(x: Int): Int requires x > 0 { x + 1 }

method q3(x: Int, z: Int, c: Bool)
{
  if (x == z) { assert f(x) == f(z) }
  if (c) { inhale x > 0; assert g(x) == x + 1 }
  refute c ==> g(x) == x + 1
}
