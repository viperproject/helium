// A fact an arm inhales under an intra-block condition reaches the arm's join
// guarded by both conditions, never unguarded. The first `if` builds the
// working graph before the branch.
//
// Must FAIL (the assert after the join).

domain D { function f(x: Int): Int }

method i3(x: Int, z: Int, c: Bool, d: Bool)
{
  if (x == z) { assert f(x) == f(z) }
  if (d) {
    assert c ==> (x == 1 ==> f(x) == f(1))
    inhale c ==> x == 1
  }
  assert x == 1
}
