// A match the working graph finds only under a branch is consumed through the
// guarded pc-alias debit and never merges the chunks: where `c` fails, `x` and
// `y` may differ and only the half at `x` is held.
//
// Must FAIL (the last exhale, on the path where `c` holds both halves are gone).
field f: Int

domain D { function g(x: Int): Int }

method merged_under_branch(x: Ref, y: Ref, c: Bool, z: Int)
  requires acc(x.f, 1/2) && acc(y.f, 1/2)
{
  if (z == 3) { assert g(z) == g(3) }
  if (c) {
    inhale x == y
    exhale acc(y.f, 1/1)
  }
  exhale acc(x.f, 1/2)
}
