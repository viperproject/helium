// A block reached by `goto` from arms of two different diamonds (`P`, emitted
// at the end) sees neither arm's fact unguarded. The first `if` builds the
// working graph before the branch.
//
// Must FAIL (`assert x == 1` at `P`).

domain D { function f(x: Int): Int }

method w2(x: Int, z: Int, c: Bool, d: Bool)
{
  if (x == z) { assert f(x) == f(z) }
  if (c) { inhale x == 1; assert f(x) == f(1); if (d) { goto P } }
  if (!c) { inhale x == 2; assert f(x) == f(2); if (d) { goto P } }
  assert x == 1 || x == 2
  goto E
  label P
  assert d
  assert x == 1
  label E
}
