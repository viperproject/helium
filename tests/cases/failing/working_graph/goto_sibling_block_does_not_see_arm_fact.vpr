// Two `goto` targets of one branch (`A`, then `B`) are siblings: `B`, walked
// after `A`'s subtree, must not see `A`'s fact. The first `if` builds the
// working graph before the branch.
//
// Must FAIL (the assert at `B`).

domain D { function f(x: Int): Int }

method g4(x: Int, z: Int, c: Bool)
{
  if (x == z) { assert f(x) == f(z) }
  if (c) { goto A }
  goto B
  label A
  inhale x == 7
  assert f(x) == f(7)
  goto E
  label B
  assert x == 7
  label E
}
