// A fact the loop body inhales does not hold after the loop: the body may not
// run. The first `if` builds the working graph before the branch.
//
// Must FAIL (the assert after the loop).

domain D { function f(x: Int): Int }

method l1(x: Int, z: Int, n: Int)
{
  var i: Int := 0
  if (x == z) { assert f(x) == f(z) }
  while (i < n) invariant 0 <= i
  {
    inhale x == 5
    assert f(x) == f(5)
    i := i + 1
  }
  assert x == 5
}
