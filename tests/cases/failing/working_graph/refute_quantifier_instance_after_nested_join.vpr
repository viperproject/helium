// A quantifier inhaled in an arm still instantiates after a nested branch's
// join inside that arm, so a `refute` of an instance fails. The first `if`
// builds the working graph before the branch.
//
// Must FAIL (the `refute`).

domain D { function f(x: Int): Int }

method q5(x: Int, z: Int, c: Bool)
{
  if (x == z) { assert f(x) == f(z) }
  if (c) {
    inhale forall i: Int :: { f(i) } f(i) > 0
    if (x > 0) { assert f(x) > 0 } else { assert f(z) > 0 }
    refute f(x + 7) > 0
  }
}
