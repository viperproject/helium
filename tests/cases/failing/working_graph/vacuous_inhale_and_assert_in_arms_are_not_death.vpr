// A vacuous inhale in one arm and a vacuous assert in the other make neither
// arm nor the join dead. The first `if` builds the working graph before the
// branch.
//
// Must FAIL (`assert false` after the join).

domain D { function f(x: Int): Int }

method v5(x: Int, z: Int, c: Bool)
  requires x == 1
{
  if (x == z) { assert f(x) == f(z) }
  if (c) {
    inhale (x == 2) ==> false
    assert f(x) == f(1)
  } else {
    assert c ==> false
  }
  assert false
}
