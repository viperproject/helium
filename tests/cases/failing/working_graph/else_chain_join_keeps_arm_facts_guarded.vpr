// After an else-chain's joins every arm's fact holds guarded by its arm's
// condition (the first two asserts verify), none unguarded. The first `if`
// builds the working graph before the branch.
//
// Must FAIL (the last assert).

domain D { function f(x: Int): Int }

method n2(x: Int, z: Int, a: Int)
{
  if (x == z) { assert f(x) == f(z) }
  if (a == 0) { inhale x == 0; assert f(x) == f(0) }
  elseif (a == 1) { inhale x == 1; assert f(x) == f(1) }
  elseif (a == 2) { inhale x == 2; assert f(x) == f(2) }
  else { inhale x == 3 }
  assert 0 <= x && x <= 3
  assert a == 1 ==> x == 1
  assert x == 2
}
