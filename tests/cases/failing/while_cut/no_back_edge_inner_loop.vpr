// A `while` without a back edge to its own head whose body holds a `goto` loop.
//
// Must FAIL. Silicon: "Assertion x.f == 3 might not hold."
field f: Int

method m(x: Ref, b: Bool, c: Bool)
  requires acc(x.f)
{
  x.f := 3
  while (c)
    invariant acc(x.f)
  {
    label again
    if (b) { goto again }
    goto out
  }
  label out
  assert x.f == 3
}
