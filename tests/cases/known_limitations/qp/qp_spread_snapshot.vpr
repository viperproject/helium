// KNOWN LIMITATION: a quantified permission that no single held chunk set
// covers is taken from all holders together (`covered_by_sum` /
// `take_spread`). Its value map is then a fresh placeholder, not tied to the
// holders' maps: sound, but it says nothing.
//
// `fold` consumes the predicate body. In `fold_one` one held set covers it, so
// the predicate's snapshot is that set's map and `unfold` gives the values
// back. In `fold_two` only both sets together cover it, so the snapshot is the
// placeholder and `x.f == 5` is lost. Silicon verifies both methods.
field f: Int

predicate all(s: Set[Ref]) {
  forall y: Ref :: y in s ==> acc(y.f)
}

// Verifies.
method fold_one(s: Set[Ref], x: Ref)
  requires x in s
  requires forall y: Ref :: y in s ==> acc(y.f)
  requires x.f == 5
{
  fold all(s)
  unfold all(s)
  assert x.f == 5
}

// Fails: assertion failed.
method fold_two(s1: Set[Ref], s2: Set[Ref], x: Ref)
  requires x in s1
  requires s1 intersection s2 == Set[Ref]()
  requires forall y: Ref :: y in s1 ==> acc(y.f)
  requires forall y: Ref :: y in s2 ==> acc(y.f)
  requires x.f == 5
{
  fold all(s1 union s2)
  unfold all(s1 union s2)
  assert x.f == 5
}
