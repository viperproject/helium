// KNOWN LIMITATION: "insufficient permission" when re-folding a predicate that
// was unfolded at `wildcard`.
//
// `unfold acc(P(x), wildcard)` yields some positive amount of `x.f`; folding
// `P(x)` back at `wildcard` needs only some positive amount of it, which is
// held. Helium rejects the fold.
//
// Reduced from `Vi/viper/all/chalice/RingBufferRd` (method `Head`).
field f: Int

predicate P(x: Ref) {
  acc(x.f)
}

method m(x: Ref)
  requires acc(P(x), wildcard)
{
  unfold acc(P(x), wildcard)
  fold acc(P(x), wildcard)
}
