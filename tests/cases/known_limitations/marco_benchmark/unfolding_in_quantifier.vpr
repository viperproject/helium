// KNOWN LIMITATION: "unsupported: `unfolding` inside a quantifier" for an
// `unfolding` inside a pure `forall` in a method body. It typechecks (the body
// allows what its host allows); translation rejects it, since a body cannot
// unfold per binding.
//
// Seen in `Vi/viper/all/functions/linkedlists` (`test02`).
domain D {
  function h(i: Int): Bool
}

predicate P(x: Ref) {
  true
}

method m(x: Ref)
  requires acc(P(x))
{
  assert forall i: Int :: { h(i) } h(i) ==> (unfolding acc(P(x)) in true)
}
