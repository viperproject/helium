// KNOWN LIMITATION: "`unfolding` not allowed in a domain axiom" for an
// `unfolding` inside a pure `forall` in a method body. Method-level quantifiers
// are lowered with the domain-axiom rules (`typed::AxiomExt`), which reject
// every heap construct, and the message wrongly calls the quantifier an axiom.
//
// Seen in `Vi/viper/all/functions/linkedlists` (`test02`).
domain D {
  function h(i: Int): Bool
}

predicate P(x: Ref) {
  true
}

method m(x: Ref)
  requires acc(P(x))
{
  assert forall i: Int :: { h(i) } h(i) ==> (unfolding acc(P(x)) in true)
}
