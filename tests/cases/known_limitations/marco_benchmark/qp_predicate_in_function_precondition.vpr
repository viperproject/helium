// KNOWN LIMITATION: "unsupported construct: quantified permission" for a
// quantified predicate permission in a function precondition.
//
// Prusti's `snap_owned_range_aliased`, `snap_frac_ref_range_aliased` and
// `snap_unique_ref_current_range_aliased` (slices / `Vec` / `ArrayList`) have
// this shape. Quantified permissions in any position block 49 of the 838
// listed marco_benchmark files (45 after the snapshot and quantifier fixes).
predicate P(a: Int)

function f(n: Int): Int
  requires forall a: Int :: { P(a) } 0 <= a && a < n ==> acc(P(a), wildcard)

method client()
  requires acc(P(0)) && acc(P(1))
{
  var r: Int := f(2)
}
