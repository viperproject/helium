// KNOWN LIMITATION: "assertion failed": the proof needs a case split on
// `f + l == |d|` versus `f + l > |d|`, which decides the branch of `contents`
// on the old state.
//
// With `requires f + l == |d|` or `requires f + l > |d|` instead of `>=`, each
// case verifies. The e-graph tiers do not split on the undecided condition,
// and the Z3 rung gives up at its default resource limit: with
// `SILVER_OXIDE_Z3_RLIMIT=50000000` this verifies.
//
// Reduced from `Vi/viper/all/chalice/RingBufferRd` (method `Push`, ring buffer
// wrap-around).
function contents(d: Seq[Int], f: Int, l: Int): Seq[Int]
  requires 0 <= f && 0 <= l && (|d| > 0 ==> l <= |d| && f < |d|)
{
  |d| == 0 ? Seq[Int]() :
    (f + l <= |d| ? d[f..f + l] : d[f..] ++ d[..f + l - |d|])
}

method wrap(d: Seq[Int], f: Int, l: Int, x: Int)
  requires 0 <= f && 0 <= l && |d| > 0 && l < |d| && f < |d|
  requires f + l >= |d|
{
  var n: Int := f + l - |d|
  var d2: Seq[Int] := d[..n] ++ Seq(x) ++ d[n + 1..]
  assert contents(d2, f, l + 1) == contents(d, f, l) ++ Seq(x)
}
