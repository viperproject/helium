// KNOWN LIMITATION: "unimplemented: purify: snap value outside footprint" on
// `g#ensures`, then "assertion failed" on `g`, when a predicate is held with an
// amount given by an abstract function, `acc(P(x), rd())`. The same program
// with a literal amount `1/2` verifies.
//
// Prusti (`Ru1/prusti`) declares `function read$(): Perm` (with
// `none < result < write`) and uses it for every shared borrow. Its enum
// `discriminant` functions (`Option`, `Tree`, `Link`, ...) have exactly this
// shape: `ensures discriminant(snap(self)) == result`.
field d: Int

predicate P(x: Ref) {
  acc(x.d)
}

function rd(): Perm
  ensures none < result && result < write

function s(x: Ref): Int
  requires acc(P(x), rd())
{
  unfolding acc(P(x), rd()) in x.d
}

function g(x: Ref): Int
  requires acc(P(x), rd())
  ensures s(x) == result
{
  unfolding acc(P(x), rd()) in x.d
}
