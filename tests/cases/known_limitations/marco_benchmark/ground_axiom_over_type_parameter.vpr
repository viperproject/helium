// KNOWN LIMITATION: "axiom uses a domain type parameter that no trigger fixes".
// A ground axiom (no `forall`) over a generic domain's type parameter is
// rejected; Silicon instantiates it for every `T` the program uses.
//
// Nagini's prelude `__MSHelper.__toMS_def_1`
// (`__toMS(Seq[T$]()) == Multiset[T$]()`) has this shape: 12 of the 838 listed
// marco_benchmark files hit this.
domain D[T] {
  function size(s: Seq[T]): Int

  axiom {
    size(Seq[T]()) == 0
  }
}

method m() {
  assert size(Seq[Int]()) == 0
}
