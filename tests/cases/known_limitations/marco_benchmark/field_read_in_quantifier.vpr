// KNOWN LIMITATION: a field read inside a pure `forall` in a method contract is
// rejected, and with a misleading message: "field access not allowed in a
// domain axiom" (`TypeError::FieldAccessInAxiom`). Method-level quantifiers
// are lowered with the domain-axiom rules (`typed::AxiomExt`).
//
// As in `heap_function_in_quantifier.vpr`, the heap read `x.val` does not
// mention the bound variable `i` and could be hoisted out.
//
// Seen in `Vi/viper/examples/quickselect/arrays_quickselect_rec_index-shifting`.
domain D {
  function h(i: Int): Bool
}

field val: Int

method m(x: Ref)
  requires acc(x.val)
  ensures acc(x.val)
  ensures forall i: Int :: { h(i) } h(i) ==> x.val > i

method client(x: Ref)
  requires acc(x.val) && h(5)
{
  m(x)
  assert x.val > 5
}
