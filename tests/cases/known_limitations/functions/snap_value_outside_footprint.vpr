// KNOWN LIMITATION: when a function's postcondition is purified, the snapshot
// of `Q(result)` (needed for the call `g(result)` under the unfolding) is not
// found in the function's footprint, because the footprint names the instance
// as `Q(y)` and only the postcondition `result == y` relates the two
// ("unimplemented: purify: snap value outside footprint",
// `src/verify/declaration.rs`). Reduced from the Prusti-encoded Ru2 benchmarks
// (`snap_owned_non_aliased$ref$Unique$U32`, pointers.rs).
predicate Q(y: Ref)

predicate P(y: Ref) {
  acc(Q(y))
}

function g(y: Ref): Int
  requires acc(Q(y), wildcard)

function h(y: Ref): Ref
  requires acc(P(y), wildcard)
  ensures result == y
  ensures unfolding acc(P(y), wildcard) in g(result) == g(y)
