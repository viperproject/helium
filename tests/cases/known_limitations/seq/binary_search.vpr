// KNOWN LIMITATION: needs the sequence axioms (length, indexing, concatenation,
// take/drop, membership). They are not loaded, so sequences only get basic
// equality reasoning. Promote back to passing/seq once the axioms are in.
// Seq (verification-heavy): iterative binary search over a strictly sorted
// sequence, in the shape of the Viper tutorial example. The invariant keeps
// "key is not outside [low, high)" as a quantifier over the whole sequence, so
// each iteration needs the sortedness precondition instantiated at `mid`.

method binary_search(xs: Seq[Int], key: Int) returns (index: Int)
  requires forall i: Int, j: Int :: { xs[i], xs[j] } 0 <= i && j < |xs| && i < j ==> xs[i] < xs[j]
  ensures -1 <= index && index < |xs|
  ensures 0 <= index ==> xs[index] == key
  ensures index == -1 ==> forall i: Int :: { xs[i] } 0 <= i && i < |xs| ==> xs[i] != key
{
  var low: Int := 0
  var high: Int := |xs|
  index := -1

  while (low < high && index == -1)
    invariant 0 <= low && low <= high && high <= |xs|
    invariant -1 <= index && index < |xs|
    invariant 0 <= index ==> xs[index] == key
    invariant index == -1 ==>
      forall i: Int :: { xs[i] } 0 <= i && i < |xs| && !(low <= i && i < high) ==> xs[i] != key
  {
    var mid: Int := (low + high) \ 2
    if (xs[mid] < key) {
      low := mid + 1
    } else {
      if (key < xs[mid]) {
        high := mid
      } else {
        index := mid
      }
    }
  }
}

// Client on a concrete sequence: the postcondition pins the exact index.
method client_found() {
  var xs: Seq[Int] := Seq(1, 3, 5, 7, 9)
  var r: Int
  r := binary_search(xs, 7)
  assert xs[3] == 7
  assert r == 3
}

method client_absent() {
  var xs: Seq[Int] := Seq(1, 3, 5, 7, 9)
  var r: Int
  r := binary_search(xs, 4)
  assert r == -1
}

method client_empty() {
  var r: Int
  r := binary_search(Seq[Int](), 4)
  assert r == -1
}
