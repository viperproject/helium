method make_generic_Kind(self: Ref)
  requires acc(p_Kind(self), write)
  ensures acc(p_Param(self, s_Kind_type()), write)
  ensures old(make_generic_s_Kind(p_Kind_snap(self))) ==
    p_Param_snap(self, s_Kind_type())


method make_concrete_Kind(self: Ref)
  requires acc(p_Param(self, s_Kind_type()), write)
  ensures acc(p_Kind(self), write)
  ensures old(p_Param_snap(self, s_Kind_type())) ==
    make_generic_s_Kind(p_Kind_snap(self))


