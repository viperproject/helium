domain s_Int_i32  {
  
  function s_Int_i32_cons(arg0: Int): s_Int_i32 
  
  function s_Int_i32_value(arg0: s_Int_i32): Int 
  
  axiom s_Int_i32_ax_cons {
    (forall s: s_Int_i32 ::
      { s_Int_i32_value(s) }
      s_Int_i32_cons(s_Int_i32_value(s)) == s)
  }
  
  axiom s_Int_i32_ax_bounds {
    (forall s: s_Int_i32 ::
      { s_Int_i32_value(s) }
      -2147483648 <= s_Int_i32_value(s) && s_Int_i32_value(s) <= 2147483647)
  }
  
  axiom s_Int_i32_ax_value {
    (forall value: Int ::
      { s_Int_i32_cons(value) }
      -2147483648 <= value && value <= 2147483647 ==>
      s_Int_i32_value(s_Int_i32_cons(value)) == value)
  }
}

domain s_Bool  {
  
  function s_Bool_cons(arg0: Bool): s_Bool 
  
  function s_Bool_value(arg0: s_Bool): Bool 
  
  axiom s_Bool_ax_cons {
    (forall s: s_Bool ::
      { s_Bool_value(s) }
      s_Bool_cons(s_Bool_value(s)) == s)
  }
  
  axiom s_Bool_ax_value {
    (forall value: Bool ::
      { s_Bool_cons(value) }
      s_Bool_value(s_Bool_cons(value)) == value)
  }
}

domain TypeOf  {
  
  
}

field p_Int_i32_val: s_Int_i32

function s_Int_i32_unreachable(): s_Int_i32
  ensures false


function s_Cell_unreachable(): s_Cell
  ensures false


function s_Cell_field_0(self: Ref): Ref
  ensures (self == null) == (result == null)


function s_Cell_field_1(self: Ref): Ref
  ensures (self == null) == (result == null)


function s_Bool_unreachable(): s_Bool
  ensures false


function p_Int_i32_snap(self: Ref): s_Int_i32
  requires acc(p_Int_i32(self), write)
{
  (unfolding acc(p_Int_i32(self), write) in self.p_Int_i32_val)
}

function p_Cell_snap(self: Ref): s_Cell
  requires acc(p_Cell(self), write)
{
  (unfolding acc(p_Cell(self), write) in
    s_Cell_cons(p_Int_i32_snap(s_Cell_field_0(self)), p_Int_i32_snap(s_Cell_field_1(self))))
}

predicate p_Int_i32(self: Ref) {
  acc(self.p_Int_i32_val, write)
}

predicate p_Cell(self: Ref) {
  acc(p_Int_i32(s_Cell_field_0(self)), write) &&
  acc(p_Int_i32(s_Cell_field_1(self)), write)
}

method m_run(_0p: Ref, _1p: Ref)
  requires acc(p_Cell(_1p), write)
  ensures acc(p_Int_i32(_0p), write)
{
  var _2p: Ref
  label start
  // var _2p
  goto bb_0
  label bb_0
  label _before_0_0
  // [MIR] bb0[0]: StorageLive(_2)
  label _before_0_1
  // [MIR] bb0[1]: _2 = copy (_1.0: i32)
  // [PCG] Expand(RepackExpand { from: _1, guide: None, capability: R, _marker: PhantomData<&()> })
  unfold acc(p_Cell(_1p), write)
  // (ignoring) LabelPlace(LabelPlaceAction { place: _2, location: Before(AnalysisLocation { location: bb0[1], eval_stmt_phase: PreMain }), reason: Write, _marker: PhantomData<&()> })
  // (ignoring) LabelLifetimeProjection(LabelLifetimeProjectionAction { predicate: And([PlaceEquals(_2), InSourceNodes, EdgeType(BorrowFlow { future_edge_kind: Some(FromExpansion) })]), label: None })
  p_Int_i32_assign(_2p, p_Int_i32_snap(s_Cell_field_0(_1p)))
  label _before_0_2
  // [MIR] bb0[2]: FakeRead(ForLet(None), _2)
  // [PCG] Collapse(RepackCollapse { to: _1, capability: R, guide: None, _marker: PhantomData<&()> })
  fold acc(p_Cell(_1p), write)
  label _before_0_3
  // [MIR] bb0[3]: _0 = copy _2
  // (ignoring) LabelPlace(LabelPlaceAction { place: _0, location: Before(AnalysisLocation { location: bb0[3], eval_stmt_phase: PreMain }), reason: Write, _marker: PhantomData<&()> })
  // (ignoring) LabelLifetimeProjection(LabelLifetimeProjectionAction { predicate: And([PlaceEquals(_0), InSourceNodes, EdgeType(BorrowFlow { future_edge_kind: Some(FromExpansion) })]), label: None })
  p_Int_i32_assign(_0p, p_Int_i32_snap(_2p))
  label _before_0_4
  // [MIR] bb0[4]: StorageDead(_2)
  // (ignoring) LabelPlace(LabelPlaceAction { place: _2, location: Before(AnalysisLocation { location: bb0[4], eval_stmt_phase: PreMain }), reason: Write, _marker: PhantomData<&()> })
  // (ignoring) LabelLifetimeProjection(LabelLifetimeProjectionAction { predicate: And([PlaceEquals(_2), InSourceNodes, EdgeType(BorrowFlow { future_edge_kind: Some(FromExpansion) })]), label: None })
  // [PCG] Weaken(Weaken { place: _2, from: E, to: W, for_storage_dead: true, _marker: PhantomData<&()> })
  // Weaken(E, W) for _2 (skipped exhale: StorageDead)
  // (ignoring) LabelPlace(LabelPlaceAction { place: _2, location: Before(AnalysisLocation { location: bb0[4], eval_stmt_phase: PreMain }), reason: StorageDead, _marker: PhantomData<&()> })
  label _before_0_5
  // [MIR] bb0[5]: return
  // PCG (T) pre_operands
  // PCG (T) post_operands
  // PCG (T) pre_main
  // PCG (T) post_main
  label package_post0
  goto end
  label end
  // return
}

method p_Int_i32_assign(self: Ref, value: s_Int_i32)
  ensures acc(p_Int_i32(self), write)
  ensures p_Int_i32_snap(self) == value


method p_Cell_assign(self: Ref, value: s_Cell)
  ensures acc(p_Cell(self), write)
  ensures p_Cell_snap(self) == value


adt s_Cell {
  s_Cell_cons(s_Cell_0: s_Int_i32, s_Cell_1: s_Int_i32)
}

adt Type {
  Unknown_type(non_unit: Int)
}