method make_generic_Cell(self: Ref)
  requires acc(p_Cell(self), write)
  ensures acc(p_Param(self, s_Cell_type()), write)
  ensures old(make_generic_s_Cell(p_Cell_snap(self))) ==
    p_Param_snap(self, s_Cell_type())


method make_concrete_Cell(self: Ref)
  requires acc(p_Param(self, s_Cell_type()), write)
  ensures acc(p_Cell(self), write)
  ensures old(p_Param_snap(self, s_Cell_type())) ==
    make_generic_s_Cell(p_Cell_snap(self))


method make_generic_Int_i32(self: Ref)
  requires acc(p_Int_i32(self), write)
  ensures acc(p_Param(self, s_Int_i32_type()), write)
  ensures old(make_generic_s_Int_i32(p_Int_i32_snap(self))) ==
