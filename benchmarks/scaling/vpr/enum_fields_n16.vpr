method make_generic_Int_i32(self: Ref)
  requires acc(p_Int_i32(self), write)
  ensures acc(p_Param(self, s_Int_i32_type()), write)
  ensures old(make_generic_s_Int_i32(p_Int_i32_snap(self))) ==
    p_Param_snap(self, s_Int_i32_type())


method make_concrete_Int_i32(self: Ref)
  requires acc(p_Param(self, s_Int_i32_type()), write)
  ensures acc(p_Int_i32(self), write)
  ensures old(p_Param_snap(self, s_Int_i32_type())) ==
    make_generic_s_Int_i32(p_Int_i32_snap(self))


method make_generic_Bool(self: Ref)
  requires acc(p_Bool(self), write)
  ensures acc(p_Param(self, s_Bool_type()), write)
  ensures old(make_generic_s_Bool(p_Bool_snap(self))) ==
    p_Param_snap(self, s_Bool_type())


method make_concrete_Bool(self: Ref)
  requires acc(p_Param(self, s_Bool_type()), write)
  ensures acc(p_Bool(self), write)
  ensures old(p_Param_snap(self, s_Bool_type())) ==
